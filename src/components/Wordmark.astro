---
import { WORDMARK_LANCK, WORDMARK_P, WORDMARK_SLICE, WORDMARK_VIEWBOX } from '../lib/wordmark';

interface Props {
	width: number;
	height: number;
	ink?: string;
	ember?: string;
	class?: string;
	/** Omit to hide the wordmark from assistive tech (when a parent link carries the name). */
	label?: string;
}
const { width, height, ink = '#F2EFEA', ember = '#FF7A1F', class: cls, label } = Astro.props;
---

<svg
	class={cls}
	width={width}
	height={height}
	viewBox={WORDMARK_VIEWBOX}
	xmlns="http://www.w3.org/2000/svg"
	role={label ? 'img' : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
	focusable="false"
>
	<path fill-rule="evenodd" d={WORDMARK_P} fill={ink}></path>
	<path fill-rule="evenodd" d={WORDMARK_SLICE} fill={ember}></path>
	<path fill-rule="evenodd" d={WORDMARK_LANCK} fill={ink}></path>
</svg>
