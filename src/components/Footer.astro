---
import {
	ARCHITECTURE,
	BENCHMARKS,
	DOCS,
	ISSUES,
	LICENSE_URL,
	PRIVACY,
	PROTOCOL,
	RELEASES,
	REPO,
} from '../lib/site';
import Wordmark from './Wordmark.astro';

const groups = [
	{
		title: 'Product',
		links: [
			{ href: '/download', label: 'Download' },
			{ href: '/api/download?platform=windows', label: 'Windows' },
			{ href: '/api/download?platform=macos', label: 'macOS' },
			{ href: RELEASES, label: 'Changelog' },
		],
	},
	{
		title: 'Developers',
		links: [
			{ href: DOCS, label: 'Docs' },
			{ href: ARCHITECTURE, label: 'Architecture' },
			{ href: PROTOCOL, label: 'Protocol' },
			{ href: BENCHMARKS, label: 'Benchmarks' },
			{ href: PRIVACY, label: 'Privacy & Telemetry' },
		],
	},
	{
		title: 'Open Source',
		links: [
			{ href: REPO, label: 'GitHub' },
			{ href: ISSUES, label: 'Issues' },
			{ href: LICENSE_URL, label: 'Apache-2.0' },
		],
	},
];
---

<footer class="footer">
	<div class="footer__floor wash" aria-hidden="true"></div>
	<div class="footer__cols">
		<div class="footer__brand">
			<a href="/" aria-label="Planck home" class="footer__home">
				<Wordmark width={125} height={26} />
			</a>
			<p class="footer__tag mono">planck.gg · Pure Go</p>
		</div>
		{
			groups.map((g, i) => (
				<nav class:list={['footer__group', { 'footer__group--wide': i === 2 }]} aria-label={g.title}>
					<h2 class="footer__title mono">{g.title}</h2>
					<ul>
						{g.links.map((l, j) => (
							<li>
								<a class:list={{ 'is-lead': j === 0 }} href={l.href}>
									{l.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}
	</div>
	<div class="footer__monument" aria-hidden="true">
		<Wordmark width={1152} height={240} ink="#454852" ember="#B5551E" />
	</div>
	<div class="footer__bar">
		<p>Planck · planck.gg</p>
	</div>
</footer>

<style>
	.footer {
		position: relative;
		overflow: clip;
		display: flex;
		flex-direction: column;
		gap: 108px;
		padding: 128px var(--pad) 56px;
		background: linear-gradient(in oklab 180deg, #0e0f12 0%, #090a0d 100%);
	}
	.footer__floor {
		left: 0;
		right: 0;
		bottom: -340px;
		height: 340px;
		background: radial-gradient(ellipse 68% 72% at 50% 100% in oklab, #ff7a1f1a 0%, #00000000 74%);
	}
	.footer__cols {
		position: relative;
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 64px;
	}
	.footer__brand {
		flex: 1.8 1 0;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.footer__home {
		align-self: flex-start;
	}
	.footer__tag {
		font-size: 12px;
		line-height: 20px;
		color: #8b909c;
	}
	.footer__group {
		flex: 1 1 0;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.footer__title {
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.08em;
		line-height: 16px;
		text-transform: uppercase;
		color: #9da3b0;
	}
	.footer__group ul {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.footer__group a {
		display: inline-block;
		padding-block: 1px;
		font-size: 15px;
		line-height: 22px;
		color: var(--muted);
		transition: color 120ms var(--ease-out);
	}
	.footer__group a.is-lead {
		color: #d4d6dc;
	}
	.footer__group a:hover {
		color: var(--text);
	}
	.footer__monument {
		position: relative;
		display: flex;
		justify-content: center;
		padding-block: 12px;
	}
	.footer__monument :global(svg) {
		width: 100%;
		height: auto;
	}
	.footer__bar {
		position: relative;
		padding-top: 28px;
		border-top: 1px solid #1a1d24;
		font-size: 13px;
		line-height: 18px;
		color: #8b909c;
	}
	@media (max-width: 767px) {
		.footer {
			gap: 56px;
			padding: 72px 24px 40px;
		}
		.footer__cols {
			flex-wrap: wrap;
			gap: 36px 24px;
		}
		.footer__brand {
			flex-basis: 100%;
			gap: 14px;
		}
		.footer__group {
			flex: 1 1 calc(50% - 12px);
		}
		.footer__group--wide {
			flex-basis: 100%;
		}
		.footer__group--wide ul {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 10px 36px;
		}
		.footer__bar {
			padding-top: 24px;
		}
	}
</style>
