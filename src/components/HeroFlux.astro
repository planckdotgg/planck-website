---
/**
 * Glassline: the hero's light is the stream itself. A WebGL canvas behind the copy and the
 * client window, plus a static CSS twin shown when WebGL is missing or the context is lost.
 */
---

<canvas class="hero__flux" width="1" height="1" aria-hidden="true"></canvas>
<div class="hero__flux-flat" aria-hidden="true"></div>
<noscript><style is:inline>.hero__flux-flat{display:block}</style></noscript>

<script>
	import '../scripts/flux';
</script>

<style>
	.hero__flux {
		position: absolute;
		inset: 0;
		z-index: 1;
		display: block;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
	.hero__flux-flat {
		--glass-y-fallback: calc(100svh - var(--nav-h) - var(--peek));
		position: absolute;
		inset: 0;
		z-index: 1;
		display: none;
		pointer-events: none;
	}
	:global(.hero--flat) .hero__flux {
		display: none;
	}
	:global(.hero--flat) .hero__flux-flat {
		display: block;
	}
	.hero__flux-flat::before {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: var(--glass-y, var(--glass-y-fallback));
		height: 1px;
		background: linear-gradient(
			90deg,
			#f2efea00,
			#f2efea1f 18%,
			#f2efea2b 50%,
			#f2efea1f 82%,
			#f2efea00
		);
	}
	.hero__flux-flat::after {
		content: '';
		position: absolute;
		left: 50%;
		translate: -50% 0;
		width: min(52%, 680px);
		bottom: calc(100% - var(--glass-y, var(--glass-y-fallback)) + 22px);
		height: 210px;
		background: repeating-linear-gradient(180deg, #ffb46b1a 0 1px, #0000 1px 56px);
		mask-image: linear-gradient(180deg, #0000, #000 72%);
	}
</style>
