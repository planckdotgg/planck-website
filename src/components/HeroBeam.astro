---
/**
 * Ember Beam: a stream of light pours onto the client window's top bezel and spills down its
 * right side. One WebGL canvas covers the header and the hero and is screen-blended,
 * so the spill can bleed into the glass; a static CSS twin shows when WebGL is missing or lost.
 */
---

<canvas class="hero__beam" width="1" height="1" aria-hidden="true"></canvas>
<div class="hero__beam-flat" aria-hidden="true"></div>
<noscript><style is:inline>.hero__beam-flat{display:block}</style></noscript>

<script>
	import '../scripts/ember';
</script>

<style>
	/* Reaches up behind the header (z-index 10) so the stream enters from the top of the viewport;
	   the shader dims it there so the nav stays legible. */
	.hero__beam {
		position: absolute;
		top: calc(-1 * var(--nav-h));
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 11;
		display: block;
		width: 100%;
		pointer-events: none;
		mix-blend-mode: screen;
	}
	@media (max-width: 767px) {
		.hero__beam {
			top: -62px;
		}
	}
	/* Gradients only: the twin follows --beam-x and --glass-y without moving a box, so it never
	   counts as a layout shift. */
	.hero__beam-flat {
		--glass-y-fallback: calc(100svh - var(--nav-h) - var(--peek));
		--gy: var(--glass-y, var(--glass-y-fallback));
		--bx: var(--beam-x, 76%);
		position: absolute;
		inset: 0;
		z-index: 1;
		display: none;
		pointer-events: none;
		background:
			radial-gradient(
				ellipse 2px var(--gy) at var(--bx) var(--gy),
				#f2efea 0%,
				#ffd1a3b3 45%,
				#ffd1a300 100%
			),
			radial-gradient(
				ellipse 34px var(--gy) at var(--bx) var(--gy),
				#ff7a1f40 0%,
				#ff7a1f14 50%,
				#ff7a1f00 100%
			),
			radial-gradient(
				ellipse 260px 2px at var(--bx) var(--gy),
				#ffd1a3cc 0%,
				#ffd1a300 100%
			),
			radial-gradient(
				ellipse 220px 34px at var(--bx) var(--gy),
				#ffd1a359 0%,
				#ff7a1f1f 45%,
				#ff7a1f00 100%
			),
			radial-gradient(
				ellipse 420px 520px at var(--bx) var(--gy),
				#e85d0e2e 0%,
				#e85d0e0f 45%,
				#e85d0e00 75%
			);
	}
	:global(.hero--flat) .hero__beam {
		display: none;
	}
	:global(.hero--flat) .hero__beam-flat {
		display: block;
	}
</style>
