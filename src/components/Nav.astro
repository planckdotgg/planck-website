---
import { DOCS, REPO } from '../lib/site';
import Wordmark from './Wordmark.astro';

interface Props {
	active?: 'gaming' | 'work' | 'roadmap' | 'download';
}
const { active } = Astro.props;
const pages = [
	{ href: '/gaming', label: 'Gaming', key: 'gaming' },
	{ href: '/work', label: 'Work', key: 'work' },
	{ href: '/roadmap', label: 'Roadmap', key: 'roadmap' },
] as const;
---

<header class="nav">
	<a class="nav__brand" href="/" aria-label="Planck home">
		<Wordmark width={106} height={22} class="nav__mark" />
	</a>
	<nav class="nav__links" aria-label="Main">
		{
			pages.map((p) => (
				<a
					class="nav__link nav__link--page"
					href={p.href}
					aria-current={active === p.key ? 'page' : undefined}
				>
					{p.label}
				</a>
			))
		}
		<a class="nav__link" href={DOCS}>Docs</a>
		<a class="nav__link" href={REPO}>GitHub</a>
		<span class="nav__cta" data-active={active === 'download' ? '' : undefined}>
			<a
				class="nav__download"
				href="/download"
				aria-current={active === 'download' ? 'page' : undefined}>Download</a
			>
		</span>
	</nav>
</header>

<style>
	.nav {
		position: relative;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		height: var(--nav-h);
		padding-inline: var(--nav-pad);
		background: linear-gradient(in oklab 180deg, #101218 0%, #0b0c0f 100%);
		border-bottom: 1px solid #f2efea14;
	}
	.nav__brand {
		display: flex;
		align-items: center;
		padding: 8px 0;
	}
	.nav__links {
		display: flex;
		align-items: center;
		gap: 36px;
		height: 100%;
	}
	.nav__link {
		position: relative;
		display: flex;
		align-items: center;
		height: 100%;
		font-size: 14px;
		font-weight: 500;
		line-height: 20px;
		color: var(--text-2);
		transition: color 120ms var(--ease-out);
	}
	.nav__link:hover {
		color: var(--text);
	}
	.nav__link[aria-current='page'] {
		color: var(--text);
		font-weight: 600;
	}
	.nav__link[aria-current='page']::after,
	.nav__cta[data-active]::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 2px;
		background: var(--accent);
	}
	.nav__link:focus-visible,
	.nav__download:focus-visible {
		outline-offset: 4px;
	}
	.nav__cta {
		position: relative;
		display: flex;
		align-items: center;
		height: 100%;
	}
	.nav__download {
		display: flex;
		align-items: center;
		height: 36px;
		padding-inline: 18px;
		border-radius: 6px;
		background: #f2efea14;
		border: 1px solid #f2efea38;
		font-size: 13px;
		font-weight: 600;
		line-height: 16px;
		color: var(--text);
		transition:
			background-color 120ms var(--ease-out),
			border-color 120ms var(--ease-out);
	}
	.nav__download:hover {
		background: #f2efea24;
		border-color: #f2efea5c;
	}
	@media (max-width: 767px) {
		.nav {
			--nav-h: 62px;
		}
		.nav__mark {
			width: 86px;
			height: 18px;
		}
		.nav__links {
			gap: 16px;
		}
		.nav__link {
			font-size: 13px;
			line-height: 18px;
		}
		.nav__link--page {
			display: none;
		}
		.nav__download {
			height: 30px;
			padding-inline: 12px;
		}
	}
</style>
