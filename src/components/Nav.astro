---
import { REPO } from '../lib/site';
import Mark from './Mark.astro';

interface Props {
	active?: 'gaming' | 'work' | 'roadmap' | 'download';
}
const { active } = Astro.props;
const links = [
	{ href: '/gaming', label: 'Gaming', key: 'gaming' },
	{ href: '/work', label: 'Work', key: 'work' },
	{ href: '/roadmap', label: 'Roadmap', key: 'roadmap' },
] as const;
---

<header class="nav">
	<div class="wrap nav__inner">
		<a class="nav__brand" href="/" aria-label="Planck home">
			<Mark size={24} />
			<span class="nav__word display">planck</span>
		</a>
		<nav class="nav__links" aria-label="Main">
			{
				links.map((l) => (
					<a
						class="nav__link"
						href={l.href}
						aria-current={active === l.key ? 'page' : undefined}
					>
						{l.label}
					</a>
				))
			}
			<a class="nav__link" href={REPO} rel="noopener">
				GitHub <span aria-hidden="true" class="nav__ext">↗</span>
			</a>
		</nav>
		<div class="nav__end">
			<a
				class="btn btn--primary nav__cta"
				href="/download"
				aria-current={active === 'download' ? 'page' : undefined}>Download</a
			>
			<button
				class="nav__burger"
				type="button"
				aria-expanded="false"
				aria-controls="nav-drawer"
				aria-label="Menu"
			>
				<span></span><span></span><span></span>
			</button>
		</div>
	</div>
	<div class="nav__drawer" id="nav-drawer" hidden>
		<nav aria-label="Mobile" class="wrap">
			<ul>
				{
					links.map((l) => (
						<li>
							<a href={l.href} aria-current={active === l.key ? 'page' : undefined}>
								{l.label}
							</a>
						</li>
					))
				}
				<li><a href="/download">Download</a></li>
				<li><a href={REPO} rel="noopener">GitHub <span aria-hidden="true">↗</span></a></li>
			</ul>
		</nav>
	</div>
</header>

<script>
	const burger = document.querySelector<HTMLButtonElement>('.nav__burger');
	const drawer = document.getElementById('nav-drawer');
	if (burger && drawer) {
		const set = (open: boolean) => {
			burger.setAttribute('aria-expanded', String(open));
			drawer.hidden = !open;
			document.documentElement.classList.toggle('nav-open', open);
		};
		burger.addEventListener('click', () => set(burger.getAttribute('aria-expanded') !== 'true'));
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !drawer.hidden) {
				set(false);
				burger.focus();
			}
		});
		matchMedia('(min-width: 901px)').addEventListener('change', (e) => e.matches && set(false));
	}
</script>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(14, 15, 18, 0.86);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-bottom: 1px solid rgba(44, 48, 56, 0.7);
	}
	.nav__inner {
		height: var(--nav-h);
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}
	.nav__brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		justify-self: start;
		min-height: 44px;
	}
	.nav__word {
		font-size: 20px;
		line-height: 1;
		letter-spacing: -0.01em;
	}
	.nav__links {
		display: flex;
		gap: 4px;
	}
	.nav__link {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 4px;
		min-height: 44px;
		padding: 0 16px;
		color: var(--bone-300);
		font-size: 15px;
		font-weight: 500;
		transition: color var(--dur-fast) var(--ease-out);
	}
	.nav__link:hover,
	.nav__link[aria-current='page'] {
		color: var(--bone-50);
	}
	.nav__link[aria-current='page'] {
		font-weight: 600;
	}
	.nav__link[aria-current='page']::after {
		content: '';
		position: absolute;
		left: 50%;
		bottom: 4px;
		width: 18px;
		height: 2px;
		margin-left: -9px;
		background: var(--ember-500);
		border-radius: 2px;
	}
	.nav__ext {
		font-size: 11px;
	}
	.nav__end {
		justify-self: end;
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.nav__cta {
		min-height: 38px;
		padding: 0 18px;
	}
	.nav__burger {
		display: none;
		width: 44px;
		height: 44px;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		gap: 4px;
		border-radius: var(--radius-sm);
	}
	.nav__burger span {
		display: block;
		width: 18px;
		height: 2px;
		border-radius: 2px;
		background: var(--bone-50);
		transition: transform var(--dur-base) var(--ease-out), opacity var(--dur-fast);
	}
	.nav__burger[aria-expanded='true'] span:nth-child(1) {
		transform: translateY(6px) rotate(45deg);
	}
	.nav__burger[aria-expanded='true'] span:nth-child(2) {
		opacity: 0;
	}
	.nav__burger[aria-expanded='true'] span:nth-child(3) {
		transform: translateY(-6px) rotate(-45deg);
	}
	.nav__drawer {
		border-top: 1px solid var(--carbon-700);
		background: var(--carbon-900);
		padding-block: 8px 16px;
	}
	.nav__drawer a {
		display: flex;
		align-items: center;
		gap: 6px;
		min-height: 52px;
		border-bottom: 1px solid rgba(44, 48, 56, 0.6);
		font-size: 18px;
		font-weight: 500;
	}
	.nav__drawer a[aria-current='page'] {
		color: var(--ember-500);
	}
	@media (max-width: 900px) {
		.nav__inner {
			grid-template-columns: 1fr auto;
		}
		.nav__links {
			display: none;
		}
		.nav__burger {
			display: inline-flex;
		}
	}
	@media (max-width: 600px) {
		.nav__word {
			font-size: 18px;
		}
		.nav__cta {
			min-height: 44px;
			padding: 0 16px;
		}
	}
</style>
