---
/*
 * An educational 4:2:0 | 4:4:4 comparison. Two full-size layers of the same editor sit on top
 * of each other; the 4:2:0 layer is clipped at the divider. It is a CSS simulation, not encoder
 * output, and says so.
 */
const layers = [
	{
		key: '420',
		side: 'left',
		file: 'YUV 4:2:0 · 10-bit',
		tag: '4:2:0 · Quarter chroma',
		note: 'Crisp luma, smeared 1px red/orange chroma',
		loupe: '4:2:0 · 2×2 chroma fringing',
	},
	{
		key: '444',
		side: 'right',
		file: 'YUV 4:4:4 · 10-bit',
		tag: '4:4:4 · Full chroma',
		note: 'Full color sample per pixel',
		loupe: '4:4:4 · Full per-pixel chroma',
	},
] as const;
---

<div class="cc" data-curtain style="--split: 50%">
	<div class="cc__stage" data-curtain-stage>
		{
			layers.map((l) => (
				<div class={`cc__layer cc__layer--${l.key}`} aria-hidden={l.key === '444' ? undefined : 'true'}>
					<div class="cc__bar mono">
						<span class="cc__lights" aria-hidden="true">
							<i />
							<i />
							<i />
						</span>
						<span class="cc__file">chroma444.go</span>
						<span class="c-muted">shader_pq.metal</span>
						<span class={`cc__fmt cc__fmt--${l.side}`}>{l.file}</span>
					</div>
					<div class={`cc__tagrow cc__tagrow--${l.side}`}>
						<span class="cc__tag mono">{l.tag}</span>
						<span class="cc__note mono">{l.note}</span>
					</div>
					<pre class="cc__code"><code><span class="k">func</span> <span class="f">EncodeSlice</span>(frame *<span class="t">Surface</span>, mode <span class="t">Chroma</span>) {'{'}
    <span class="k">if</span> mode == <span class="n">YUV444_10BIT</span> &amp;&amp; cap.NVENC {'{'}
        cfg.TargetChroma = <span class="n">0xFF7A1F</span> <span class="c">// full Cb/Cr</span>
        cfg.EdgeGuard = <span class="s">"1px-crimson-syntax"</span>
        <span class="k">return</span> <span class="t">SubmitZeroCopy</span>(frame, <span class="n">1.41</span>)
    {'}'}
{'}'}</code></pre>
					<div class="cc__loupe">
						<div class="cc__loupe-bar mono">
							<span>4× zoom · Illustrative simulation · Why 4:4:4 matters</span>
							<span class="cc__nostock">Not stock HEVC output</span>
						</div>
						<div class="cc__loupe-body">
							<div>
								<p class="cc__loupe-label mono">{l.loupe}</p>
								<p class="cc__zoom mono">return 0xFF</p>
							</div>
							<div>
								<p class="cc__loupe-label mono">{l.loupe}</p>
								<p class="cc__zoom mono">return 0xFF</p>
							</div>
						</div>
					</div>
				</div>
			))
		}
		<div class="cc__divider" aria-hidden="true"></div>
		<div
			class="cc__handle"
			role="slider"
			tabindex="0"
			aria-label="Comparison divider: left of it is 4:2:0, right of it is 4:4:4"
			aria-valuemin="0"
			aria-valuemax="100"
			aria-valuenow="50"
			aria-valuetext="50% 4:2:0, 50% 4:4:4"
		>
			<svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"
				><path d="M7 5 2 10l5 5M13 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8"
				></path></svg
			>
		</div>
	</div>
	<div class="cc__foot">
		<div class="cc__modes" role="group" aria-label="Compare">
			<button type="button" class="seg__btn" data-split="100" aria-pressed="false">4:2:0</button>
			<button type="button" class="seg__btn" data-split="50" aria-pressed="true">Split</button>
			<button type="button" class="seg__btn" data-split="0" aria-pressed="false">4:4:4</button>
		</div>
		<p class="meta">
			Drag the divider, or focus it and press ← / →. A CSS simulation for illustration, not encoder
			output.
		</p>
	</div>
</div>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-curtain]')) {
		const stage = root.querySelector<HTMLElement>('[data-curtain-stage]');
		const handle = root.querySelector<HTMLElement>('[role="slider"]');
		const modes = [...root.querySelectorAll<HTMLButtonElement>('[data-split]')];
		if (!stage || !handle) continue;

		let split = 50;
		const set = (value: number) => {
			split = Math.round(Math.min(100, Math.max(0, value)));
			root.style.setProperty('--split', `${split}%`);
			handle.setAttribute('aria-valuenow', String(split));
			handle.setAttribute('aria-valuetext', `${split}% 4:2:0, ${100 - split}% 4:4:4`);
			for (const m of modes) m.setAttribute('aria-pressed', String(Number(m.dataset.split) === split));
		};
		const fromPointer = (clientX: number) => {
			const rect = stage.getBoundingClientRect();
			set(((clientX - rect.left) / rect.width) * 100);
		};

		stage.addEventListener('pointerdown', (e) => {
			if (e.button !== 0) return;
			stage.setPointerCapture(e.pointerId);
			root.dataset.dragging = '';
			fromPointer(e.clientX);
			handle.focus({ preventScroll: true });
		});
		stage.addEventListener('pointermove', (e) => {
			if (stage.hasPointerCapture(e.pointerId)) fromPointer(e.clientX);
		});
		const stop = (e: PointerEvent) => {
			if (stage.hasPointerCapture(e.pointerId)) stage.releasePointerCapture(e.pointerId);
			delete root.dataset.dragging;
		};
		stage.addEventListener('pointerup', stop);
		stage.addEventListener('pointercancel', stop);

		handle.addEventListener('keydown', (e) => {
			const step = e.shiftKey ? 10 : 2;
			const moves: Record<string, number> = {
				ArrowLeft: split - step,
				ArrowDown: split - step,
				ArrowRight: split + step,
				ArrowUp: split + step,
				PageDown: split - 10,
				PageUp: split + 10,
				Home: 0,
				End: 100,
			};
			const next = moves[e.key];
			if (next === undefined) return;
			e.preventDefault();
			set(next);
		});
		for (const m of modes) m.addEventListener('click', () => set(Number(m.dataset.split)));
	}
</script>

<style>
	.cc {
		position: relative;
		border: 1px solid var(--carbon-700);
		border-radius: var(--radius-md);
		background: var(--carbon-950);
		overflow: hidden;
		box-shadow: 0 24px 64px rgba(0, 0, 0, 0.62);
	}
	.cc__modes {
		display: inline-flex;
		flex: none;
		gap: 2px;
		padding: 3px;
		border-radius: var(--radius-sm);
		border: 1px solid var(--carbon-700);
		background: var(--carbon-950);
	}
	.cc__modes .seg__btn {
		min-height: 28px;
		padding: 0 12px;
	}
	.cc__stage {
		position: relative;
		height: 436px;
		touch-action: pan-y;
		cursor: ew-resize;
		user-select: none;
		-webkit-user-select: none;
	}
	.cc__layer {
		position: absolute;
		inset: 0;
		background: var(--carbon-950);
	}
	.cc__layer--420 {
		z-index: 1;
		clip-path: inset(0 calc(100% - var(--split)) 0 0);
		background: #0b0c0f;
	}
	[data-dragging] .cc__layer--420,
	[data-dragging] .cc__divider,
	[data-dragging] .cc__handle {
		transition: none;
	}
	.cc__layer--420,
	.cc__divider,
	.cc__handle {
		transition:
			clip-path var(--dur-base) var(--ease-out),
			left var(--dur-base) var(--ease-out);
	}
	.cc__bar {
		display: flex;
		align-items: center;
		gap: 12px;
		height: 38px;
		padding: 0 18px;
		border-bottom: 1px solid var(--carbon-700);
		background: var(--carbon-850);
		font-size: 10.5px;
		color: var(--bone-50);
	}
	.cc__lights {
		display: inline-flex;
		gap: 6px;
	}
	.cc__lights i {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--fault);
	}
	.cc__lights i:nth-child(2) {
		background: var(--relay);
	}
	.cc__lights i:nth-child(3) {
		background: var(--direct);
	}
	.cc__file {
		padding: 2px 10px;
		border: 1px solid var(--ember-500);
		border-radius: 4px;
	}
	.cc__fmt {
		position: absolute;
		top: 12px;
		font-size: 10.5px;
	}
	.cc__fmt--left {
		right: calc(50% + 18px);
	}
	.cc__fmt--right {
		right: 18px;
		color: var(--direct);
	}
	.cc__tagrow {
		position: absolute;
		top: 52px;
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.cc__tagrow--left {
		left: 24px;
	}
	.cc__tagrow--right {
		right: 24px;
		flex-direction: row-reverse;
	}
	.cc__tag {
		padding: 3px 10px;
		border: 1px solid var(--carbon-600);
		border-radius: 4px;
		font-size: 10.5px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--bone-50);
	}
	.cc__tagrow--right .cc__tag {
		border-color: var(--ember-500);
		color: var(--ember-500);
	}
	.cc__note {
		font-size: 10px;
		color: #e4e7ee;
	}
	.cc__code {
		position: absolute;
		top: 92px;
		left: 24px;
		right: 0;
		margin: 0;
		padding-left: 18px;
		border-left: 1px solid var(--carbon-600);
		font-size: 13px;
		line-height: 27px;
		color: var(--bone-50);
		white-space: pre;
	}
	.cc__code .k {
		color: #ff8a6b;
	}
	.cc__code .f {
		color: var(--bone-50);
	}
	.cc__code .t {
		color: var(--direct);
	}
	.cc__code .n {
		color: var(--ember-500);
	}
	.cc__code .s {
		color: #ff7a7a;
	}
	.cc__code .c {
		color: var(--muted);
	}

	/* 4:2:0 keeps every luma edge but stores one color sample per 2×2 block, so colored glyphs
	   bleed their hue into the dark around them. The glyph itself keeps its color, so the text
	   stays above AA contrast. */
	.cc__layer--420 .cc__code .k,
	.cc__layer--420 .cc__code .t,
	.cc__layer--420 .cc__code .n,
	.cc__layer--420 .cc__code .s {
		text-shadow:
			1px 0 1.5px color-mix(in srgb, currentColor 45%, transparent),
			-1px 0 1.5px color-mix(in srgb, currentColor 30%, transparent),
			0 1px 2px color-mix(in srgb, currentColor 20%, transparent);
	}

	.cc__loupe {
		position: absolute;
		left: 50%;
		bottom: 22px;
		width: min(680px, calc(100% - 48px));
		transform: translateX(-50%);
		border: 1px solid var(--carbon-600);
		border-radius: var(--radius-sm);
		background: var(--carbon-900);
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55);
	}
	.cc__loupe-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
		padding: 8px 14px;
		border-bottom: 1px solid var(--carbon-700);
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--bone-50);
	}
	.cc__nostock {
		padding: 2px 8px;
		border: 1px solid var(--carbon-600);
		border-radius: 999px;
		font-size: 9px;
		color: var(--ember-300);
	}
	.cc__loupe-body {
		display: grid;
		grid-template-columns: 1fr 1fr;
	}
	.cc__loupe-body > div {
		padding: 12px 18px 14px;
		overflow: hidden;
	}
	.cc__loupe-label {
		font-size: 9.5px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #e4e7ee;
		margin-bottom: 2px;
	}
	.cc__layer--444 .cc__loupe-label {
		color: var(--ember-300);
	}
	.cc__zoom {
		font-size: 30px;
		line-height: 38px;
		font-weight: 600;
		color: #ff6b6b;
	}
	.cc__layer--420 .cc__zoom {
		text-shadow:
			3px 0 3px rgba(255, 107, 107, 0.6),
			-3px 0 3px rgba(255, 107, 107, 0.45),
			0 3px 4px rgba(255, 107, 107, 0.35),
			0 -3px 4px rgba(255, 107, 107, 0.3);
	}

	.cc__divider {
		position: absolute;
		z-index: 2;
		top: 0;
		bottom: 0;
		left: var(--split);
		width: 2px;
		margin-left: -1px;
		background: var(--ember-500);
		pointer-events: none;
	}
	.cc__handle {
		position: absolute;
		z-index: 2;
		top: 50%;
		left: var(--split);
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		margin: -18px 0 0 -18px;
		border-radius: 50%;
		border: 2px solid var(--ember-500);
		background: var(--carbon-900);
		color: var(--ember-500);
		cursor: ew-resize;
	}
	.cc__handle:focus-visible {
		outline-offset: 4px;
		border-radius: 50%;
	}
	.cc__foot {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 8px 14px;
		border-top: 1px solid var(--carbon-700);
		background: var(--carbon-850);
	}

	@media (max-width: 900px) {
		.cc__note,
		.cc__fmt--left,
		.cc__layer .c-muted {
			display: none;
		}
		.cc__code {
			font-size: 11px;
			line-height: 23px;
		}
		.cc__stage {
			height: 440px;
		}
	}
	@media (max-width: 600px) {
		.cc__foot {
			flex-direction: column;
			align-items: stretch;
			gap: 8px;
		}
		.cc__modes .seg__btn {
			flex: 1;
			justify-content: center;
			min-height: 44px;
		}
		.cc__stage {
			height: 460px;
		}
		.cc__bar .cc__fmt {
			display: none;
		}
		.cc__tagrow {
			top: 50px;
		}
		.cc__tagrow--left {
			left: 12px;
		}
		.cc__tagrow--right {
			right: 12px;
		}
		.cc__tag {
			font-size: 9px;
			padding: 2px 6px;
		}
		.cc__code {
			top: 88px;
			left: 12px;
			padding-left: 10px;
			font-size: 9px;
			line-height: 20px;
		}
		.cc__loupe {
			width: calc(100% - 24px);
			bottom: 12px;
		}
		.cc__loupe-bar {
			flex-direction: column;
			align-items: flex-start;
			gap: 4px;
			font-size: 8.5px;
		}
		.cc__loupe-body > div {
			padding: 8px 10px 10px;
		}
		.cc__loupe-label {
			font-size: 8px;
		}
		.cc__zoom {
			font-size: 18px;
			line-height: 24px;
		}
		.cc__handle {
			width: 44px;
			height: 44px;
			margin: -22px 0 0 -22px;
		}
	}
</style>
