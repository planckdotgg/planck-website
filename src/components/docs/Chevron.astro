---
interface Props {
	dir: 'down' | 'left' | 'right';
}
const paths = {
	down: 'M1.5 3.5 L5 7 L8.5 3.5',
	left: 'M6.5 1.5 L3 5 L6.5 8.5',
	right: 'M3.5 1.5 L7 5 L3.5 8.5',
};
---

<svg class="chev" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
	<path d={paths[Astro.props.dir]} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
