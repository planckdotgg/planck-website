---
interface Props {
	stats: { value: string; unit?: string; label: string }[];
}
const { stats } = Astro.props;
---

<dl class="stat-rail">
	{
		stats.map((s) => (
			<div class="stat-rail__cell">
				<dt class="stat-rail__label">{s.label}</dt>
				<dd class="stat-rail__value">
					{s.value}
					{s.unit && <span class="u">{s.unit}</span>}
				</dd>
			</div>
		))
	}
</dl>
