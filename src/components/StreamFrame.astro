---
import { Picture } from 'astro:assets';
import racing from '../assets/hero-home-racing@2x.png';

const stages = [
	{
		key: 'capture',
		label: 'Capture',
		grow: 76,
		detail: 'DXGI Desktop Duplication · ScreenCaptureKit, frames stay on the GPU',
	},
	{
		key: 'encode',
		label: 'Encode',
		grow: 107,
		detail: 'NVENC · AMF · oneVPL · VideoToolbox, NVENC sub-frame slices',
	},
	{
		key: 'net',
		label: 'Net',
		grow: 61,
		detail: 'AES-128-GCM over UDP · adaptive Reed–Solomon FEC · QUIC control',
	},
	{
		key: 'decode',
		label: 'Decode',
		grow: 83,
		detail: 'Media Foundation on Windows · VideoToolbox on macOS',
	},
	{ key: 'present', label: 'Present', grow: 69, detail: 'MyGo GPU surface, zero-copy present' },
];
---

<div class="sf" data-stream-frame>
	<div class="sf__screen" data-hud-area>
		<Picture
			src={racing}
			alt="Illustration: a matte-black hypercar sliding through a rain-soaked night street, ember tail lights glowing."
			widths={[640, 960, 1248, 1920, 2492]}
			sizes="(max-width: 1440px) calc(100vw - 48px), 1248px"
			formats={['avif', 'webp']}
			fallbackFormat="jpg"
			quality={78}
			loading="eager"
			fetchpriority="high"
			class="sf__img"
		/>
		<div class="sf__vignette" aria-hidden="true"></div>
		<div class="sf__sweep" aria-hidden="true"></div>

		<div class="hud-hair" aria-hidden="true"></div>
		<div class="sf__hud hud-float">
			<button
				type="button"
				class="hud sf__pill"
				aria-pressed="false"
				data-hud-pill
				title="Pin the HUD"
			>
				<span class="hud__badge sf__badge">Illustrative HUD</span>
				<span class="sf__route"><span class="dot dot--direct"></span> <span data-hud-route>Direct LAN</span></span>
				<span class="hud__sep sf__wide" aria-hidden="true"></span>
				<span class="sf__wide">1440p · 240 Hz</span>
				<span class="sf__narrow">1440p240</span>
				<span class="hud__sep sf__wide" aria-hidden="true"></span>
				<span class="c-muted sf__wide">HEVC 10-bit · 0% loss</span>
				<span class="sr-only" data-hud-pin-state>Click to pin.</span>
			</button>
			<p class="sf__qual mono sf__qual--top">Illustrative HUD · up to 240 Hz paced on supported GPUs</p>
		</div>
		<p class="sf__qual mono sf__qual--bottom">Illustrative HUD · up to 240 Hz paced on supported GPUs</p>
		<p class="sf__hint mono" aria-hidden="true">
			HUD auto-hides after 2.5 s · Hover top edge or press Ctrl+Alt+H
		</p>
	</div>

	<div class="sf__bar">
		<div class="seg sf__routes" role="tablist" aria-label="Route">
			<button
				class="seg__btn"
				role="tab"
				id="route-lan"
				aria-selected="true"
				aria-controls="route-readout"
				tabindex="0"
				data-route="Direct LAN"><span class="dot dot--direct"></span>LAN Direct</button
			>
			<button
				class="seg__btn"
				role="tab"
				id="route-ts"
				aria-selected="false"
				aria-controls="route-readout"
				tabindex="-1"
				data-route="Tailscale Direct"
				><span class="dot dot--direct"></span>Tailscale<span class="sf__wide-inline"> Direct</span></button
			>
		</div>
		<div class="sf__readout mono" id="route-readout" role="tabpanel" aria-live="polite">
			<span data-readout="0"
				><b>1452 B LAN</b> · AES-128-GCM UDP · <b>LAN-first</b></span
			>
			<span data-readout="1" class="is-off" aria-hidden="true"
				><b>1152 B Tailscale</b> · WhoIs · AES-128-GCM UDP</span
			>
		</div>
		<span class="sf__aes mono">AES-128-GCM UDP</span>
		<div class="sf__pipe" role="group" aria-label="Pipeline stages">
			{
				stages.map((s) => (
					<button
						type="button"
						class={`sf__stage sf__stage--${s.key}`}
						style={`flex-grow:${s.grow}`}
						aria-pressed="false"
						aria-describedby="pipe-detail"
						data-detail={s.detail}
					>
						<span class="sf__stage-bar" aria-hidden="true" />
						<span class="sf__stage-label mono">{s.label}</span>
					</button>
				))
			}
			<p class="sf__detail mono" id="pipe-detail" role="status"></p>
		</div>
	</div>
</div>

<script>
	import { autoHideHud } from '../scripts/hud';
	import { tablist } from '../scripts/tabs';

	for (const root of document.querySelectorAll<HTMLElement>('[data-stream-frame]')) {
		const area = root.querySelector<HTMLElement>('[data-hud-area]');
		const pill = root.querySelector<HTMLButtonElement>('[data-hud-pill]');
		const routeText = root.querySelector<HTMLElement>('[data-hud-route]');
		if (!area || !pill) continue;
		const { show } = autoHideHud(root, area, pill, 2500);

		// Route inspector: both readouts share one grid cell, so swapping them never moves the bar.
		const readouts = root.querySelectorAll<HTMLElement>('[data-readout]');
		tablist(
			root.querySelector('[role="tablist"]'),
			(tab, index) => {
				readouts.forEach((r, i) => {
					r.classList.toggle('is-off', i !== index);
					r.setAttribute('aria-hidden', String(i !== index));
				});
				if (routeText) routeText.textContent = tab.dataset.route ?? '';
				show();
			},
			true,
		);

		// Pipeline: a stage shows what runs there.
		const detail = root.querySelector<HTMLElement>('#pipe-detail');
		const stages = [...root.querySelectorAll<HTMLButtonElement>('.sf__stage')];
		const pick = (stage: HTMLButtonElement | null) => {
			for (const s of stages) s.setAttribute('aria-pressed', String(s === stage));
			if (!detail) return;
			const label = stage?.querySelector('.sf__stage-label')?.textContent ?? '';
			detail.textContent = stage ? `${label}: ${stage.dataset.detail}` : '';
			detail.classList.toggle('is-on', Boolean(stage));
		};
		for (const s of stages) {
			s.addEventListener('click', () => pick(s.getAttribute('aria-pressed') === 'true' ? null : s));
			s.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') pick(null);
			});
		}
		document.addEventListener('click', (e) => {
			if (!(e.target as Element).closest('.sf__pipe')) pick(null);
		});
	}
</script>

<style>
	.sf {
		border: 1px solid var(--carbon-700);
		border-radius: var(--radius-md);
		overflow: hidden;
		background: var(--carbon-950);
	}
	.sf__screen {
		position: relative;
		aspect-ratio: 2492 / 908;
		overflow: hidden;
		isolation: isolate;
	}
	.sf__screen :global(.sf__img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.sf__screen :global(picture) {
		position: absolute;
		inset: 0;
	}
	.sf__vignette {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			radial-gradient(40% 55% at 0% 0%, rgba(7, 8, 10, 0.55), transparent 70%),
			radial-gradient(40% 55% at 100% 0%, rgba(7, 8, 10, 0.55), transparent 70%),
			linear-gradient(to bottom, rgba(7, 8, 10, 0.35), transparent 22%, transparent 70%, rgba(7, 8, 10, 0.55));
		box-shadow: inset 0 0 120px rgba(7, 8, 10, 0.6);
	}
	.sf__sweep {
		position: absolute;
		inset: 0;
		pointer-events: none;
		transform: translateY(-100%);
		animation: sweep 4.2s var(--ease-out) infinite;
	}
	.sf__sweep::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 38px;
		background: linear-gradient(to bottom, rgba(255, 122, 31, 0), rgba(255, 122, 31, 0.1));
		border-bottom: 2px solid rgba(255, 122, 31, 0.85);
	}
	@keyframes sweep {
		0% {
			transform: translateY(-100%);
			opacity: 1;
		}
		26% {
			transform: translateY(0);
			opacity: 1;
		}
		30%,
		100% {
			transform: translateY(0);
			opacity: 0;
		}
	}

	.sf__hud {
		position: absolute;
		top: 16px;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
	}
	.sf__pill {
		cursor: pointer;
		padding-right: 18px;
	}
	.sf__pill[aria-pressed='true'] {
		border-color: rgba(255, 122, 31, 0.6);
	}
	.sf__route {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		color: var(--direct);
	}
	.sf__narrow {
		display: none;
	}
	.sf__qual {
		padding: 3px 11px;
		border-radius: var(--radius-pill);
		background: rgba(14, 15, 18, 0.8);
		border: 1px solid var(--carbon-700);
		font-size: 9.5px;
		line-height: 13px;
		color: #e4e7ee;
		white-space: nowrap;
	}
	.sf__qual--bottom {
		display: none;
	}
	.sf__hint {
		position: absolute;
		bottom: 14px;
		left: 0;
		right: 0;
		text-align: center;
		font-size: 10px;
		letter-spacing: 0.03em;
		color: var(--bone-300);
		text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8);
	}
	@media (hover: none) {
		.sf__hint {
			display: none;
		}
	}

	.sf__bar {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 10px 20px;
		border-top: 1px solid var(--carbon-700);
		background: var(--carbon-850);
	}
	.sf__readout {
		display: grid;
		font-size: 12px;
		color: var(--bone-300);
		white-space: nowrap;
	}
	.sf__readout > span {
		grid-area: 1 / 1;
		transition: opacity var(--dur-fast) var(--ease-out);
	}
	.sf__readout .is-off {
		opacity: 0;
		visibility: hidden;
	}
	.sf__readout b {
		font-weight: 500;
		color: var(--bone-50);
	}
	.sf__aes {
		display: none;
		font-size: 11px;
		color: var(--bone-300);
	}
	.sf__pipe {
		position: relative;
		margin-left: auto;
		display: flex;
		gap: 6px;
		width: 420px;
	}
	.sf__stage {
		display: flex;
		flex-direction: column;
		gap: 7px;
		flex-basis: 0;
		min-height: 36px;
		justify-content: center;
		text-align: left;
		border-radius: 3px;
	}
	.sf__stage-bar {
		height: 3px;
		border-radius: 2px;
		background: var(--stage);
		transition: height var(--dur-fast) var(--ease-out);
	}
	.sf__stage:hover .sf__stage-bar,
	.sf__stage[aria-pressed='true'] .sf__stage-bar {
		height: 5px;
	}
	.sf__stage-label {
		font-size: 9.5px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.sf__stage[aria-pressed='true'] .sf__stage-label {
		color: var(--bone-50);
	}
	.sf__stage--capture {
		--stage: var(--k2000);
	}
	.sf__stage--encode {
		--stage: var(--k3000);
	}
	.sf__stage--net {
		--stage: var(--k4000);
	}
	.sf__stage--decode {
		--stage: var(--k6500);
	}
	.sf__stage--present {
		--stage: var(--k10000);
	}
	.sf__detail {
		position: absolute;
		right: 0;
		bottom: calc(100% + 14px);
		width: max-content;
		max-width: 420px;
		padding: 8px 12px;
		border-radius: var(--radius-sm);
		background: var(--hud-surface);
		border: 1px solid var(--hud-border);
		backdrop-filter: blur(16px);
		font-size: 11px;
		line-height: 16px;
		color: var(--bone-50);
		opacity: 0;
		transform: translateY(4px);
		pointer-events: none;
		transition:
			opacity var(--dur-base) var(--ease-out),
			transform var(--dur-base) var(--ease-out);
	}
	.sf__detail:empty {
		display: none;
	}
	.sf__detail.is-on {
		opacity: 1;
		transform: none;
	}

	@media (max-width: 1100px) {
		.sf__pipe {
			width: 300px;
		}
		.sf__stage-label {
			font-size: 8.5px;
		}
	}
	@media (max-width: 900px) {
		.sf__bar {
			flex-wrap: wrap;
		}
		.sf__pipe {
			width: 100%;
			margin-left: 0;
		}
		.sf__detail {
			left: 0;
			right: auto;
			max-width: 100%;
			white-space: normal;
		}
	}
	@media (max-width: 600px) {
		.sf__screen {
			aspect-ratio: 16 / 11;
		}
		.sf__screen :global(.sf__img) {
			object-position: 58% 50%;
		}
		.sf__hud {
			top: 12px;
		}
		.sf__badge,
		.sf__wide,
		.sf__wide-inline,
		.sf__qual--top,
		.sf__hint {
			display: none;
		}
		.sf__narrow {
			display: inline;
		}
		.sf__pill {
			gap: 8px;
			padding: 8px 14px;
			min-height: 44px;
		}
		.sf__qual--bottom {
			display: block;
			position: absolute;
			bottom: 12px;
			left: 50%;
			transform: translateX(-50%);
			width: max-content;
			max-width: calc(100% - 24px);
			white-space: normal;
			text-align: center;
			border-radius: 12px;
			font-size: 10px;
		}
		.sf__bar {
			padding: 10px 12px 12px;
			gap: 10px;
		}
		.sf__readout {
			display: none;
		}
		.sf__aes {
			display: inline;
			margin-left: auto;
			font-size: 10px;
		}
		.sf__routes .seg__btn {
			min-height: 44px;
			padding: 0 10px;
		}
		.sf__stage {
			min-height: 44px;
		}
		.sf__stage-label {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.sf__sweep {
			display: none;
		}
	}
</style>
