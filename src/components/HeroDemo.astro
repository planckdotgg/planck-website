---
import sceneSvg from '../assets/hero-scene.svg?raw';

const poster = sceneSvg.replace(
	/<svg[^>]*>/,
	'<svg viewBox="0 0 1296 516" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" class="viewport__art" aria-hidden="true" focusable="false">',
);
---

<div class="hero-demo" data-demo>
	<div class="viewport">
		<div class="viewport__scene" aria-hidden="true">
			<div class="wash wash--fill viewport__zenith"></div>
			<div class="wash viewport__bloom"></div>
			<div class="wash wash--fill viewport__gate"></div>
			<div class="wash wash--fill viewport__thrust"></div>
			<Fragment set:html={poster} />
			<div class="wash viewport__scrim"></div>
		</div>
		<p class="pill viewport__pill">
			<span class="pill__dot"></span><span>120 FPS · 4:4:4 · 4 ms (simulated)</span>
		</p>
		<div class="viewport__invite">
			<button type="button" class="play" data-demo-open hidden>
				<span class="play__icon" aria-hidden="true">
					<svg width="9" height="10" viewBox="0 0 9 10"><path d="M1.5 1 L8.5 5 L1.5 9 Z" fill="#1A0B02"></path></svg>
				</span>
				<span class="play__label"><span class="play__long">Play live demo</span><span class="play__short">Play demo</span></span>
				<span class="play__sub mono">· Compare 4 ms vs 45 ms</span>
			</button>
		</div>
	</div>

	<dialog class="demo" data-demo-dialog data-mode="planck" aria-label="Planck latency demo">
		<div class="demo__stage" data-demo-stage tabindex="0" aria-describedby="demo-help">
			<canvas class="demo__canvas" data-demo-canvas></canvas>
			<div class="demo__fade" aria-hidden="true"></div>
			<div class="demo__readouts">
				<p class="pill">
					<span class="pill__dot"></span><span data-demo-telemetry>60 FPS · 4:4:4 · 4 ms (simulated)</span>
				</p>
				<p class="chip mono" data-demo-gates>Gates 0 / 0</p>
			</div>
			<button type="button" class="chip demo__exit" data-demo-exit aria-label="Exit demo (Esc)">
				<span class="demo__esc mono" aria-hidden="true">Esc</span><span class="demo__esc-sep" aria-hidden="true">·</span><span aria-hidden="true">Exit</span>
			</button>
			<p class="sr-only" id="demo-help">
				Thread the green gates on the inner line of the turn. Hold A or Left Arrow to steer in, D or
				Right Arrow to steer out, and Shift for the airbrake. On a touch screen, hold the left or
				right half; hold both to brake.
			</p>
		</div>
		<div class="demo__bar">
			<p class="demo__label" id="demo-latency-label">Simulated input latency</p>
			<p class="demo__hint mono" aria-hidden="true">
				<span class="demo__hint-keys">A / D steer &amp; bank · Shift airbrake</span>
				<span class="demo__hint-touch">Hold a side to steer · both to brake</span>
			</p>
			<div class="seg" role="radiogroup" aria-labelledby="demo-latency-label">
				<button type="button" class="seg__opt" role="radio" data-mode="planck" aria-checked="true">
					<span class="seg__dot" aria-hidden="true"></span>Planck · 4 ms
				</button>
				<button type="button" class="seg__opt" role="radio" data-mode="cloud" aria-checked="false" tabindex="-1">
					<span class="seg__dot" aria-hidden="true"></span>Cloud · 45 ms
				</button>
			</div>
		</div>
	</dialog>
</div>

<script>
	import '../scripts/demo/demo';
</script>

<style>
	.hero-demo {
		position: relative;
		width: 100%;
		max-width: 1296px;
	}
	.viewport {
		position: relative;
		aspect-ratio: 1296 / 516;
		border-radius: 14px;
		overflow: clip;
		border: 1px solid #ffb27a40;
		box-shadow:
			#ff7a1f38 0 0 120px,
			#6e3b2840 0 0 36px,
			#000000d9 0 36px 84px;
	}
	.viewport__scene {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			in oklab 180deg,
			#101728 0%,
			#1f1d32 30%,
			#3e2736 46%,
			#7f4228 54%,
			#171926 57%,
			#0b0d14 100%
		);
	}
	.viewport__zenith {
		bottom: auto;
		height: 46.5%;
		background: radial-gradient(ellipse 68% 54% at 32% 8% in oklab, #4864a036 0%, #141b2d00 72%);
	}
	.viewport__bloom {
		left: 0;
		right: 0;
		top: 0;
		height: 69.8%;
		background: radial-gradient(
			ellipse 48% 52% at 70% 56% in oklab,
			#ff9b52a8 0%,
			#c65a2e5c 34%,
			#52293624 64%,
			#00000000 86%
		);
	}
	.viewport__gate {
		background: radial-gradient(ellipse 30% 34% at 62% 48% in oklab, #4cd69b42 0%, #4cd69b12 46%, #00000000 76%);
	}
	.viewport__thrust {
		background: radial-gradient(ellipse 34% 28% at 34% 78% in oklab, #ff7a1f78 0%, #ff944726 42%, #00000000 76%);
	}
	.viewport__scene :global(.viewport__art) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.viewport__scrim {
		left: 0;
		right: 0;
		bottom: 0;
		height: 112px;
		background: linear-gradient(in oklab 180deg, #090a0e00 0%, #090a0eb8 58%, #090a0ee8 100%);
	}
	.pill {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 8px 14px;
		border-radius: 999px;
		background: #0e0f12db;
		border: 1px solid #f2efea26;
		box-shadow: #00000040 0 8px 24px;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.01em;
		line-height: 14px;
		color: var(--text);
		white-space: nowrap;
	}
	.pill__dot {
		width: 7px;
		height: 7px;
		flex-shrink: 0;
		border-radius: 999px;
		background: var(--direct);
		box-shadow: #4cd69bbf 0 0 10px;
	}
	.viewport__pill {
		position: absolute;
		left: 22px;
		top: 20px;
	}
	.viewport__invite {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 20px;
		display: flex;
		justify-content: center;
	}
	.play {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		padding: 10px 22px 10px 16px;
		border-radius: 999px;
		border: 1px solid #ff7a1fc4;
		background: linear-gradient(in oklab 180deg, #16181ef2 0%, #0e0f12f8 100%);
		box-shadow:
			#ff7a1f38 0 0 36px,
			#000000b3 0 14px 34px;
		transition:
			border-color 120ms var(--ease-out),
			box-shadow 120ms var(--ease-out);
	}
	.play[hidden] {
		display: none;
	}
	.play:hover {
		border-color: var(--accent);
		box-shadow:
			#ff7a1f5c 0 0 44px,
			#000000b3 0 14px 34px;
	}
	.play__icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 24px;
		height: 24px;
		border-radius: 999px;
		background: var(--accent);
	}
	.play__label {
		font-size: 14px;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 18px;
		color: var(--text);
	}
	.play__short {
		display: none;
	}
	.play__sub {
		font-size: 11px;
		line-height: 14px;
		color: var(--muted);
	}

	.demo {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: #090a0e;
		color: var(--text);
		overflow: hidden;
	}
	.demo:not([open]) {
		display: none;
	}
	.demo[open] {
		display: flex;
		flex-direction: column;
	}
	.demo::backdrop {
		background: #090a0e;
	}
	.demo::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		box-shadow: inset 0 0 0 1px #4cd69b40;
	}
	.demo[data-mode='cloud']::after {
		box-shadow: inset 0 0 0 1px #f2c94c40;
	}
	.demo__stage {
		position: relative;
		flex: 1 1 auto;
		min-height: 0;
		overflow: hidden;
		touch-action: none;
		user-select: none;
		-webkit-user-select: none;
		cursor: crosshair;
	}
	.demo__stage:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: -4px;
		border-radius: 0;
	}
	.demo__canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.demo__fade {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 40px;
		background: linear-gradient(in oklab 180deg, #090a0e00 0%, #090a0e 100%);
		pointer-events: none;
	}
	.demo__readouts {
		position: absolute;
		left: 22px;
		top: 20px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 8px;
		pointer-events: none;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 6px 12px;
		border-radius: 999px;
		background: #0e0f12e0;
		border: 1px solid #f2efea24;
		font-size: 10.5px;
		line-height: 14px;
		color: var(--muted);
	}
	.demo__exit {
		position: absolute;
		right: 16px;
		top: 16px;
		min-height: 28px;
		gap: 5px;
		font-size: 11px;
		cursor: pointer;
	}
	.demo__exit:hover {
		border-color: #f2efea4d;
	}
	.demo__esc {
		font-size: 10.5px;
		font-weight: 600;
		color: var(--text);
	}
	.demo__bar {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 18px 20px;
		background: #090a0e;
		border-top: 1px solid #f2efea10;
	}
	.demo__label {
		font-size: 12px;
		font-weight: 500;
		line-height: 16px;
		color: var(--muted);
	}
	.demo__hint {
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		font-size: 11px;
		line-height: 14px;
		color: var(--text-3);
		white-space: nowrap;
	}
	.demo__hint-touch {
		display: none;
	}
	.seg {
		display: flex;
		align-items: center;
		gap: 4px;
		padding: 4px;
		border-radius: 999px;
		background: #111319;
		border: 1px solid #f2efea20;
	}
	.seg__opt {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		padding: 7px 14px;
		border-radius: 999px;
		border: 1px solid transparent;
		font-family: var(--font-mono);
		font-size: 11px;
		line-height: 14px;
		color: var(--text-3);
		white-space: nowrap;
	}
	.seg__opt:hover {
		color: var(--text);
	}
	.seg__dot {
		display: none;
		width: 6px;
		height: 6px;
		border-radius: 999px;
	}
	.seg__opt[aria-checked='true'] {
		font-weight: 600;
		color: var(--text);
	}
	.seg__opt[aria-checked='true'] .seg__dot {
		display: block;
	}
	.seg__opt[data-mode='planck'][aria-checked='true'] {
		border-color: #ff7a1fb8;
		background: linear-gradient(in oklab 180deg, #1e1917 0%, #161417 100%);
	}
	.seg__opt[data-mode='planck'] .seg__dot {
		background: var(--direct);
	}
	.seg__opt[data-mode='cloud'][aria-checked='true'] {
		border-color: #f2c94cb8;
		background: linear-gradient(in oklab 180deg, #211d14 0%, #171516 100%);
	}
	.seg__opt[data-mode='cloud'] .seg__dot {
		background: var(--relay);
	}

	@media (max-width: 1099px) {
		.demo__hint {
			position: static;
			transform: none;
		}
	}
	@media (pointer: coarse) {
		.demo__hint-keys,
		.demo__esc,
		.demo__esc-sep {
			display: none;
		}
		.demo__hint-touch {
			display: inline;
		}
	}
	@media (max-width: 767px) {
		.viewport {
			aspect-ratio: 358 / 296;
			border-radius: 12px;
			box-shadow:
				#ff7a1f34 0 0 72px,
				#000000d9 0 22px 56px;
		}
		.viewport__pill {
			left: 12px;
			top: 12px;
		}
		.viewport__invite {
			bottom: 18px;
		}
		.play {
			padding: 8px 18px 8px 10px;
		}
		.play__long,
		.play__sub {
			display: none;
		}
		.play__short {
			display: inline;
		}
		.demo__bar {
			flex-direction: column;
			align-items: stretch;
			gap: 12px;
			padding: 14px 16px calc(14px + env(safe-area-inset-bottom));
		}
		.demo__label {
			text-align: center;
		}
		.demo__hint {
			margin-top: -6px;
			text-align: center;
			white-space: normal;
		}
		.demo__hint-keys {
			display: none;
		}
		.demo__hint-touch {
			display: inline;
		}
		.seg {
			justify-content: center;
		}
		.seg__opt {
			flex: 1 1 0;
			justify-content: center;
			padding-block: 9px;
		}
		.demo__readouts {
			left: 12px;
			top: 52px;
		}
		.demo__exit {
			right: 12px;
			top: 12px;
		}
	}
</style>

<style is:global>
	html.demo-open {
		overflow: hidden;
	}
</style>
