---
import PageHero from '../components/PageHero.astro';
import Base from '../layouts/Base.astro';
import { REPO } from '../lib/site';

const shipped = [
	'Windows and macOS host and client',
	'Zero-copy Metal and D3D11',
	'NVIDIA NVENC, AMD AMF, Intel oneVPL, Apple VideoToolbox',
	'Raw AEAD UDP and adaptive RS FEC',
	'Native Tailscale LocalAPI',
];
const phases = [
	{
		title: 'Phase 2 — Studio & LAN',
		lead: 'Targets studio workstations, local wavelet streaming, and broader OS support.',
		tone: '#FF7A1F',
		items: [
			'PyroWave LAN 4:4:4 wavelet mode',
			'Signed installers',
			'Linux host',
			'WASAPI per-process Discord echo exclusion',
			'Zero-copy OBS / Spout / Syphon texture sink',
		],
	},
	{
		title: 'Phase 3 — Cloud & Co-op',
		lead: 'Extends sessions beyond your own network with shareable links, relays, and new client platforms.',
		tone: '#8C919B',
		items: [
			'Instant planck.gg/j/ co-op & /w/ watch links',
			'Edge relays',
			'iOS, Apple TV, Android TV clients',
		],
	},
	{
		title: 'Phase 4 — Broadcast',
		lead: "Builds a lightweight broadcast stack directly on Planck's native GPU capture and encode pipeline.",
		tone: '#5A606C',
		items: ['Native single-PC compositor', 'Multi-stream broadcast engine'],
	},
];
---

<Base
	title="Roadmap · Planck"
	description="Four phases, one engine: the pure-Go core ships today; studio and LAN, cloud and co-op, and broadcast follow."
	active="roadmap"
	og="roadmap.png"
	ogAlt="Planck roadmap card: Four phases, one engine. Phase 1 shipped, then studio and LAN, cloud and co-op, broadcast."
>
	<PageHero
		title="Four phases. One engine."
		lead="From a pure-Go streaming core to studio capture, co-op relays, and native broadcast."
		cta={{ href: REPO, label: 'Follow on GitHub', arrow: true }}
		zenith="radial-gradient(ellipse 60% 64% at 24% 0% in oklab, #C9D9FF16 0%, #789BFF06 46%, #00000000 76%)"
		aura="radial-gradient(ellipse 48% 72% at 78% 58% in oklab, #FF7A1F2E 0%, #E8650C12 42%, #00000000 76%)"
	>
		<svg viewBox="0 0 472 296" role="img" aria-label="Four stacked phases: P1 Core MVP (current), P2 Studio and LAN, P3 Cloud and co-op, P4 Broadcast.">
			<path d="M52 246 L422 50" fill="none" stroke="#FF7A1F55" stroke-width="1.5" stroke-dasharray="4 5"></path>
			<polygon points="218,46 436,46 406,96 188,96" fill="#12141A" stroke="#252933" stroke-width="1.25"></polygon>
			<polygon points="168,98 386,98 356,148 138,148" fill="#14171E" stroke="#2F3440" stroke-width="1.25"></polygon>
			<polygon points="118,150 336,150 306,200 88,200" fill="#171A22" stroke="#3D4352" stroke-width="1.25"></polygon>
			<polygon points="68,202 286,202 256,252 38,252" fill="#1B1E26" stroke="#FF7A1F" stroke-width="1.75"></polygon>
			<path d="M38 252 H256" fill="none" stroke="#FF7A1F" stroke-width="3.5"></path>
			<circle cx="68" cy="227" r="4" fill="#4CD69B"></circle>
			<circle cx="118" cy="175" r="3" fill="#FFB46B"></circle>
			<circle cx="168" cy="123" r="3" fill="#8C919B"></circle>
			<circle cx="218" cy="71" r="3" fill="#5A606C"></circle>
			<text x="82" y="227" class="svg-mono" font-size="11" font-weight="600" letter-spacing="0.44" fill="#F2EFEA" dominant-baseline="central">P1 · CORE MVP</text>
			<text x="132" y="175" class="svg-mono" font-size="10.5" letter-spacing="0.42" fill="#B6B8BE" dominant-baseline="central">P2 · STUDIO &amp; LAN</text>
			<text x="182" y="123" class="svg-mono" font-size="10.5" letter-spacing="0.42" fill="#8C919B" dominant-baseline="central">P3 · CLOUD &amp; CO-OP</text>
			<text x="232" y="71" class="svg-mono" font-size="10.5" letter-spacing="0.42" fill="#6E7480" dominant-baseline="central">P4 · BROADCAST</text>
		</svg>
	</PageHero>

	<section class="band" aria-labelledby="p1-title">
		<div class="wash band__warm" aria-hidden="true"></div>
		<div class="wash band__cool" aria-hidden="true"></div>
		<div class="band__head p1__head">
			<p class="now mono">Now</p>
			<h2 id="p1-title" class="display h-band">Phase 1 — Core MVP</h2>
			<p class="band-lead">The pure-Go streaming core, shipping from source today.</p>
		</div>
		<ul class="shipped">
			{
				shipped.map((item) => (
					<li>
						<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
							<path d="M3 8.5 L6.5 12 L13 4.5" fill="none" stroke="#13804F" stroke-width="1.75" stroke-linecap="square" />
						</svg>
						<span>
							{item}
							<span class="sr-only"> (shipped)</span>
						</span>
					</li>
				))
			}
		</ul>
	</section>

	<div class="canvas">
		<ol class="timeline" aria-label="Upcoming phases">
			{
				phases.map((p) => (
					<li class="phase" style={`--tone:${p.tone}`}>
						<span class="phase__node" aria-hidden="true" />
						<div class="phase__copy">
							<h2 class="display phase__title">{p.title}</h2>
							<p class="phase__lead">{p.lead}</p>
						</div>
						<ul class="phase__items">
							{p.items.map((item) => (
								<li>
									<span class="phase__dash" aria-hidden="true" />
									{item}
								</li>
							))}
						</ul>
					</li>
				))
			}
		</ol>
		<div class="timeline__horizon" aria-hidden="true">
			<div class="wash horizon"></div>
		</div>
	</div>
</Base>

<style>
	.p1__head {
		gap: 16px;
		max-width: 720px;
	}
	.now {
		align-self: flex-start;
		padding: 5px 14px;
		border-radius: 999px;
		background: var(--ground);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		line-height: 14px;
		color: var(--direct);
	}
	.shipped {
		position: relative;
		border-top: 1px solid var(--bone-rule);
	}
	.shipped li {
		display: flex;
		align-items: center;
		gap: 18px;
		padding-block: 22px;
		border-bottom: 1px solid var(--bone-rule);
		font-size: 18px;
		font-weight: 500;
		line-height: 26px;
		color: var(--bone-ink);
	}
	.shipped svg {
		flex-shrink: 0;
	}

	.timeline {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 144px var(--pad) 48px;
	}
	.timeline::before {
		content: '';
		position: absolute;
		left: calc(var(--pad) + 6px);
		top: 156px;
		bottom: 220px;
		width: 1px;
		background: #23262e;
	}
	.phase {
		position: relative;
		display: flex;
		align-items: flex-start;
		gap: 56px;
		padding: 0 0 120px 44px;
	}
	.phase:last-child {
		padding-bottom: 96px;
	}
	.phase__node {
		position: absolute;
		left: 1px;
		top: 14px;
		width: 11px;
		height: 11px;
		background: var(--ground);
		border: 1.5px solid var(--tone);
	}
	.phase__copy {
		display: flex;
		flex-direction: column;
		gap: 16px;
		flex-shrink: 0;
		width: 416px;
		max-width: 100%;
	}
	.phase__title {
		font-size: clamp(30px, 2.78vw, 40px);
		line-height: 1.15;
		letter-spacing: -0.034em;
	}
	.phase__lead {
		font-size: 17px;
		line-height: 27px;
		color: var(--muted);
	}
	.phase__items {
		flex: 1 1 0;
		border-top: 1px solid #242833;
	}
	.phase__items li {
		display: flex;
		align-items: center;
		gap: 16px;
		padding-block: 18px;
		border-bottom: 1px solid #1c2029;
		font-size: 16px;
		font-weight: 500;
		line-height: 24px;
		color: #e2e4e9;
	}
	.phase__dash {
		flex-shrink: 0;
		width: 12px;
		height: 1.5px;
		background: var(--tone);
	}
	.timeline__horizon {
		position: relative;
		height: 220px;
		overflow: clip;
	}
	.timeline__horizon .horizon {
		height: 220px;
	}

	@media (max-width: 1199px) {
		.phase {
			flex-direction: column;
			gap: 28px;
		}
		.phase__items {
			width: 100%;
		}
	}
	@media (max-width: 767px) {
		.shipped li {
			gap: 14px;
			padding-block: 16px;
			font-size: 16px;
			line-height: 24px;
		}
		.timeline {
			padding-top: 72px;
		}
		.timeline::before {
			top: 84px;
		}
		.phase {
			padding: 0 0 72px 32px;
		}
		.phase:last-child {
			padding-bottom: 48px;
		}
		.phase__lead {
			font-size: 16px;
			line-height: 25px;
		}
	}
</style>
