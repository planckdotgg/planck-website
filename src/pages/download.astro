---
import BuildTerminal from '../components/BuildTerminal.astro';
import PageHero from '../components/PageHero.astro';
import Base from '../layouts/Base.astro';
import { REPO } from '../lib/site';

const platforms = [
	{
		id: 'macos',
		label: 'MACOS · 13+',
		name: 'macOS',
		note: 'Signed and notarized Developer ID DMG. Includes the Planck.app client and planck-host.',
		primary: { href: '/api/download?platform=macos&arch=arm64', label: 'Apple Silicon' },
		secondary: { href: '/api/download?platform=macos&arch=amd64', label: 'Intel (x86_64)' },
		color: '#C9D9FF',
	},
	{
		id: 'windows',
		label: 'WINDOWS · 10/11 X64',
		name: 'Windows',
		note: 'Windows builds are unsigned for now, so SmartScreen will prompt until code signing is in place.',
		primary: { href: '/api/download?platform=windows&format=installer', label: 'Installer (.exe)' },
		secondary: { href: '/api/download?platform=windows&format=portable', label: 'Portable ZIP' },
		color: '#FF8912',
	},
	{
		id: 'linux',
		label: 'LINUX · CLI PREVIEW',
		name: 'Linux',
		note: 'Command-line preview only. There is no desktop app on Linux yet.',
		primary: { href: '/api/download?platform=linux&arch=amd64', label: 'x86_64' },
		secondary: { href: '/api/download?platform=linux&arch=arm64', label: 'arm64' },
		color: '#4CD69B',
	},
];

const vendors = [
	{
		platform: 'WINDOWS · D3D11',
		name: 'NVIDIA NVENC',
		spec: 'HEVC / AV1 · 4:4:4 · 1.41 ms p50',
		color: '#FF8912',
	},
	{
		platform: 'WINDOWS · D3D11',
		name: 'AMD AMF',
		spec: 'Zero-copy DXGI · 2.78 ms p50',
		color: '#FFB46B',
	},
	{
		platform: 'WINDOWS · D3D11',
		name: 'Intel oneVPL',
		spec: 'VDEnc LowPower · 4:4:4 · API 2.8',
		color: '#FFD1A3',
	},
	{
		platform: 'MACOS · METAL',
		name: 'Apple VideoToolbox',
		spec: 'SCK + Metal EDR · 0.87 ms dec',
		color: '#C9D9FF',
	},
];
---

<Base
	title="Download · Planck"
	description="Download Planck for macOS, Windows, and Linux, or build planck-host and planck-client from source. Pure Go, CGO_ENABLED=0, four GPU vendors."
	active="download"
	og="download.png"
	ogAlt="Planck download card: Download Planck. macOS, Windows and a Linux command-line build, no account."
>
	<PageHero
		title="Download Planck."
		lead="Ready-to-run builds of the client and host for macOS, Windows, and Linux, straight from GitHub Releases. Prefer to compile it yourself? Build from source below."
		cta={{ href: '#downloads', label: 'Download latest release', arrow: true }}
		secondary={{ href: `${REPO}/releases/latest`, label: 'GitHub Releases' }}
		zenith="radial-gradient(ellipse 58% 64% at 22% 0% in oklab, #C9D9FF16 0%, #789BFF06 46%, #00000000 76%)"
		aura="radial-gradient(ellipse 46% 74% at 76% 52% in oklab, #FF7A1F2B 0%, #E8650C12 42%, #00000000 76%)"
	>
		<svg viewBox="0 0 472 296" role="img" aria-label="planck-host captures and encodes, sends over AEAD UDP to planck-client, which decodes and presents.">
			<path d="M12 148 H460" fill="none" stroke="#F2EFEA12" stroke-dasharray="2 6"></path>
			<path d="M12 72 H460 M12 224 H460" fill="none" stroke="#F2EFEA0A"></path>
			<path d="M236 18 V278" fill="none" stroke="#F2EFEA10" stroke-dasharray="3 5"></path>
			<rect x="28" y="48" width="146" height="200" rx="8" fill="#13151B" stroke="#343944" stroke-width="1.25"></rect>
			<path d="M28 84 H174" fill="none" stroke="#242833"></path>
			<rect x="46" y="106" width="110" height="10" rx="2" fill="#232732"></rect>
			<rect x="46" y="126" width="84" height="10" rx="2" fill="#2C313E"></rect>
			<rect x="46" y="146" width="110" height="12" rx="2" fill="#FF7A1F"></rect>
			<rect x="46" y="168" width="94" height="10" rx="2" fill="#232732"></rect>
			<rect x="46" y="188" width="72" height="10" rx="2" fill="#1D2028"></rect>
			<rect x="298" y="48" width="146" height="200" rx="8" fill="#13151B" stroke="#343944" stroke-width="1.25"></rect>
			<path d="M298 84 H444" fill="none" stroke="#242833"></path>
			<rect x="316" y="106" width="110" height="10" rx="2" fill="#232732"></rect>
			<rect x="316" y="126" width="96" height="10" rx="2" fill="#2C313E"></rect>
			<rect x="316" y="146" width="110" height="12" rx="2" fill="#4CD69B"></rect>
			<rect x="316" y="168" width="82" height="10" rx="2" fill="#232732"></rect>
			<rect x="316" y="188" width="102" height="10" rx="2" fill="#1D2028"></rect>
			<path d="M174 128 H298" fill="none" stroke="#FFB46B44" stroke-width="1.5" stroke-dasharray="5 5"></path>
			<path d="M174 152 H298" fill="none" stroke="#FF7A1F" stroke-width="2"></path>
			<rect x="212" y="145" width="48" height="14" rx="3" fill="#FF7A1F"></rect>
			<path d="M174 176 H298" fill="none" stroke="#4CD69B55" stroke-width="1.25" stroke-dasharray="3 5"></path>
			<circle cx="174" cy="152" r="3.5" fill="#F2EFEA"></circle>
			<circle cx="298" cy="152" r="3.5" fill="#4CD69B"></circle>
			<path d="M20 40 L28 40 L28 48 M452 40 L444 40 L444 48 M20 256 L28 256 L28 248 M452 256 L444 256 L444 248" fill="none" stroke="#5A606C"></path>
			<text x="46" y="67" class="svg-mono" font-size="11" font-weight="500" fill="#B6B8BE" dominant-baseline="central">planck-host</text>
			<text x="316" y="67" class="svg-mono" font-size="11" font-weight="500" fill="#B6B8BE" dominant-baseline="central">planck-client</text>
			<text x="40" y="227" class="svg-mono" font-size="9" letter-spacing="0.18" fill="#6E7480" dominant-baseline="central">CAPTURE · ENCODE</text>
			<text x="310" y="227" class="svg-mono" font-size="9" letter-spacing="0.18" fill="#6E7480" dominant-baseline="central">DECODE · PRESENT</text>
			<text x="206" y="107" class="svg-mono" font-size="10" letter-spacing="0.5" fill="#FFB27A" dominant-baseline="central">AEAD UDP</text>
		</svg>
	</PageHero>

	<section id="downloads" class="downloads" aria-labelledby="downloads-title">
		<div class="downloads__head">
			<h2 id="downloads-title" class="display h-beat">Direct downloads</h2>
			<p class="beat-lead">Latest release from GitHub Releases. Pick your platform.</p>
		</div>
		<ul class="downloads__list">
			{
				platforms.map((p) => (
					<li class="dl" id={p.id} style={`--tint:${p.color}`}>
						<span class="dl__bar" aria-hidden="true" />
						<span class="dl__label mono">{p.label}</span>
						<h3 class="dl__name">{p.name}</h3>
						<p class="dl__note">{p.note}</p>
						<div class="dl__actions">
							<a class="btn btn--primary" href={p.primary.href}>{p.primary.label}</a>
							<a class="btn btn--ghost" href={p.secondary.href}>{p.secondary.label}</a>
						</div>
					</li>
				))
			}
		</ul>
		<p class="downloads__foot spec-line">
			<a href="/api/download?asset=SHA256SUMS.txt">SHA-256 Checksums</a>
			<a href={`${REPO}/releases`}>All Releases &amp; Release Notes on GitHub</a>
		</p>
	</section>

	<section class="band" aria-labelledby="build-title">
		<div class="wash band__warm" aria-hidden="true"></div>
		<div class="wash band__cool" aria-hidden="true"></div>
		<div class="band__head">
			<h2 id="build-title" class="display h-band">Build from source</h2>
			<p class="band-lead">Requires Go 1.27+. Prefer a prebuilt binary? Use the direct downloads above.</p>
		</div>
		<BuildTerminal />
		<dl class="strip">
			<div class="strip__cell">
				<dt class="mono">BINARIES</dt>
				<dd>planck-host, planck-client</dd>
			</div>
			<div class="strip__cell">
				<dt class="mono">PLATFORMS</dt>
				<dd>Windows, macOS</dd>
			</div>
			<div class="strip__cell">
				<dt class="mono">BUILD</dt>
				<dd>Pure Go (CGO_ENABLED=0)</dd>
			</div>
		</dl>
	</section>

	<div class="canvas">
		<section class="beat beat--split split" aria-labelledby="split-title">
			<div class="wash wash--fill split__glow" aria-hidden="true"></div>
			<div class="beat__copy split__copy">
				<h2 id="split-title" class="display h-beat">Host and client, cleanly split.</h2>
				<p class="beat-lead">
					Run planck-host on the machine rendering frames and planck-client on any Windows or
					macOS display.
				</p>
				<p class="beat__rule spec-line spec-line--ember">
					planck-host → raw AEAD UDP + RS FEC → planck-client
				</p>
			</div>
			<figure class="beat__art diagram split__art" style="--min: 450px">
				<svg viewBox="0 0 628 292" role="img" aria-label="planck-host renders and encodes; raw AEAD UDP with AES-128-GCM and adaptive Reed-Solomon parity carries frames to planck-client, which decodes and presents. QUIC carries control and key export.">
					<path d="M16 140 H612" fill="none" stroke="#F2EFEA10" stroke-dasharray="2 6"></path>
					<path d="M16 220 H612" fill="none" stroke="#F2EFEA0C" stroke-dasharray="2 6"></path>
					<path d="M114 126 H514" fill="none" stroke="#FF7A1F2E" stroke-width="12" stroke-linecap="round"></path>
					<path d="M104 126 H524" fill="none" stroke="#FF7A1F" stroke-width="2" stroke-linecap="round"></path>
					<rect x="210" y="121" width="32" height="10" rx="2" fill="#FF7A1F"></rect>
					<rect x="254" y="121" width="32" height="10" rx="2" fill="#FF9447"></rect>
					<rect x="298" y="121" width="32" height="10" rx="2" fill="#FFB27A"></rect>
					<rect x="342" y="121" width="32" height="10" rx="2" fill="#FF7A1F"></rect>
					<rect x="386" y="121" width="32" height="10" rx="2" fill="#FF9447"></rect>
					<path d="M104 156 H524" fill="none" stroke="#FFB46B88" stroke-width="1.5" stroke-dasharray="6 6"></path>
					<rect x="276" y="152" width="18" height="8" rx="1.5" fill="#FFB46B"></rect>
					<rect x="334" y="152" width="18" height="8" rx="1.5" fill="#FFB46B"></rect>
					<path d="M88 160 V220 H540 V160" fill="none" stroke="#3A3F49" stroke-width="1.25" stroke-dasharray="3 4"></path>
					<circle cx="88" cy="140" r="20" fill="#12141A" stroke="#FF7A1F" stroke-width="1.75"></circle>
					<circle cx="88" cy="140" r="4" fill="#F2EFEA"></circle>
					<circle cx="540" cy="140" r="20" fill="#12141A" stroke="#4CD69B" stroke-width="1.75"></circle>
					<circle cx="540" cy="140" r="4" fill="#F2EFEA"></circle>
					<text x="40" y="66" class="svg-mono" font-size="12" font-weight="600" fill="#F2EFEA" dominant-baseline="central">planck-host</text>
					<text x="32" y="85" class="svg-mono" font-size="10" fill="#8C919B" dominant-baseline="central">Render · Encode</text>
					<text x="596" y="66" class="svg-mono" font-size="12" font-weight="600" fill="#F2EFEA" text-anchor="end" dominant-baseline="central">planck-client</text>
					<text x="598" y="85" class="svg-mono" font-size="10" fill="#8C919B" text-anchor="end" dominant-baseline="central">Decode · Present</text>
					<text x="204" y="103" class="svg-mono" font-size="10.5" font-weight="500" letter-spacing="0.42" fill="#FFB27A" dominant-baseline="central">RAW AEAD UDP · AES-128-GCM</text>
					<text x="226" y="177" class="svg-mono" font-size="10" letter-spacing="0.4" fill="#B6B8BE" dominant-baseline="central">ADAPTIVE RS FEC PARITY</text>
					<text x="182" y="239" class="svg-mono" font-size="10" letter-spacing="0.3" fill="#6E7480" dominant-baseline="central">QUIC control · ExportKeyingMaterial</text>
				</svg>
			</figure>
		</section>

		<section class="beat beat--stack vendors" aria-labelledby="vendors-title">
			<div class="wash wash--fill vendors__glow" aria-hidden="true"></div>
			<div class="beat__head vendors__head">
				<h2 id="vendors-title" class="display h-beat">Four GPU vendors supported.</h2>
				<p class="beat-lead">One pure-Go build supports every major desktop GPU pipeline out of the box.</p>
			</div>
			<ul class="vendors__list">
				{
					vendors.map((v) => (
						<li class="vendor" style={`--tint:${v.color}`}>
							<span class="vendor__bar" aria-hidden="true" />
							<span class="vendor__platform mono">{v.platform}</span>
							<span class="vendor__name">{v.name}</span>
							<span class="vendor__spec mono">{v.spec}</span>
						</li>
					))
				}
			</ul>
		</section>

		<section class="beat tailnet" aria-labelledby="tailnet-title">
			<div class="wash wash--fill tailnet__green" aria-hidden="true"></div>
			<div class="wash horizon" aria-hidden="true"></div>
			<div class="beat--split tailnet__grid">
				<figure class="beat__art tailnet__art">
					<svg viewBox="0 0 596 288" role="img" aria-label="Host and client paired over a direct tailnet path, verified without a PIN.">
						<path d="M56 206 H540" fill="none" stroke="#F2EFEA12" stroke-dasharray="2 6"></path>
						<path d="M56 206 Q298 34 540 206" fill="none" stroke="#4CD69B24" stroke-width="16" stroke-linecap="round"></path>
						<path d="M56 206 Q298 34 540 206" fill="none" stroke="#4CD69B" stroke-width="2.25" stroke-linecap="round"></path>
						<polygon points="298,96 318,120 298,144 278,120" fill="#0E0F12" stroke="#4CD69B" stroke-width="1.75"></polygon>
						<path d="M292 120 L296.5 124.5 L305 115.5" fill="none" stroke="#4CD69B" stroke-width="1.75" stroke-linecap="square"></path>
						<rect x="164" y="202" width="28" height="8" rx="1.5" fill="#2A5E4B"></rect>
						<rect x="200" y="202" width="28" height="8" rx="1.5" fill="#2A5E4B"></rect>
						<rect x="236" y="202" width="28" height="8" rx="1.5" fill="#3B8C6E"></rect>
						<rect x="272" y="202" width="28" height="8" rx="1.5" fill="#4CD69B"></rect>
						<rect x="308" y="202" width="28" height="8" rx="1.5" fill="#3B8C6E"></rect>
						<rect x="344" y="202" width="28" height="8" rx="1.5" fill="#2A5E4B"></rect>
						<rect x="380" y="202" width="28" height="8" rx="1.5" fill="#2A5E4B"></rect>
						<circle cx="56" cy="206" r="14" fill="#12141A" stroke="#FF7A1F" stroke-width="1.75"></circle>
						<circle cx="56" cy="206" r="4" fill="#F2EFEA"></circle>
						<circle cx="540" cy="206" r="14" fill="#12141A" stroke="#4CD69B" stroke-width="1.75"></circle>
						<circle cx="540" cy="206" r="4" fill="#F2EFEA"></circle>
					</svg>
				</figure>
				<div class="beat__copy">
					<h2 id="tailnet-title" class="display h-beat">Tailnet discovery built in.</h2>
					<p class="beat-lead">
						Pair automatically over Tailscale LocalAPI using WhoIs identity on your own devices,
						with no PIN.
					</p>
				</div>
			</div>
		</section>
	</div>
</Base>

<style>
	.downloads {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 48px;
		padding: 96px var(--pad) 104px;
		border-top: 1px solid #232732;
	}
	.downloads__head {
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 660px;
	}
	.downloads__list {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
	}
	.dl {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 0 28px 28px;
		border: 1px solid #232732;
		border-radius: 8px;
		background: #13151b;
		overflow: clip;
	}
	.dl__bar {
		height: 4px;
		margin-inline: -28px;
		margin-bottom: 18px;
		background: var(--tint);
	}
	.dl__label {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.05em;
		line-height: 16px;
		color: var(--tint);
	}
	.dl__name {
		font-size: 26px;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 32px;
	}
	.dl__note {
		flex: 1;
		font-size: 14.5px;
		line-height: 22px;
		color: var(--text-3);
	}
	.dl__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		padding-top: 8px;
	}
	.downloads__foot {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 32px;
		padding-top: 24px;
		border-top: 1px solid #232732;
	}
	.downloads__foot a {
		color: var(--text-2);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.downloads__foot a:hover {
		color: var(--focus);
	}

	.strip {
		position: relative;
		display: flex;
		padding-top: 32px;
		border-top: 1px solid var(--bone-rule);
	}
	.strip__cell {
		flex: 1 1 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding-inline: 28px;
	}
	.strip__cell:first-child {
		padding-left: 0;
	}
	.strip__cell:last-child {
		padding-right: 0;
	}
	.strip__cell + .strip__cell {
		border-left: 1px solid var(--bone-rule);
	}
	.strip dt {
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.06em;
		line-height: 16px;
		color: var(--bone-label);
	}
	.strip dd {
		font-size: 17px;
		font-weight: 600;
		line-height: 24px;
		color: var(--bone-ink);
	}

	.split {
		padding: 144px var(--pad) 128px;
	}
	.split__glow {
		background: radial-gradient(ellipse 46% 62% at 74% 50% in oklab, #ff7a1f1c 0%, #4cd69b0d 46%, #00000000 76%);
	}
	.split__copy {
		width: 452px;
	}
	.split__art {
		width: 628px;
	}

	.vendors {
		gap: 60px;
	}
	.vendors__glow {
		background: radial-gradient(ellipse 68% 52% at 50% 56% in oklab, #ff891214 0%, #c9d9ff0a 52%, #00000000 78%);
	}
	.vendors__head {
		max-width: 660px;
	}
	.vendors__list {
		position: relative;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		column-gap: 4px;
	}
	.vendor {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding-right: 28px;
	}
	.vendor + .vendor {
		padding-left: 28px;
	}
	.vendor__bar {
		height: 4px;
		margin-right: -28px;
		margin-bottom: 18px;
		border-radius: 2px;
		background: var(--tint);
	}
	.vendor + .vendor .vendor__bar {
		margin-left: -28px;
	}
	.vendor__platform {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.05em;
		line-height: 16px;
		color: var(--tint);
	}
	.vendor__name {
		font-size: 22px;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 28px;
	}
	.vendor__spec {
		font-size: 11.5px;
		line-height: 18px;
		color: var(--text-3);
	}
	.vendor:not(:first-child) {
		position: relative;
	}
	.vendor:not(:first-child)::before {
		content: '';
		position: absolute;
		left: -2px;
		top: 50px;
		bottom: 0;
		width: 1px;
		background: #232732;
	}

	.tailnet {
		padding: 120px var(--pad) 156px;
	}
	.tailnet__green {
		background: radial-gradient(ellipse 46% 56% at 28% 42% in oklab, #4cd69b1a 0%, #4cd69b06 44%, #00000000 76%);
	}
	.tailnet__grid {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 72px;
	}
	.tailnet__art {
		width: 596px;
	}

	@media (max-width: 1199px) {
		.downloads__list {
			grid-template-columns: 1fr;
		}
		.tailnet__grid {
			flex-direction: column-reverse;
			align-items: flex-start;
			gap: 48px;
		}
		.vendors__list {
			grid-template-columns: repeat(2, 1fr);
			row-gap: 40px;
		}
		.vendor:nth-child(3) {
			padding-left: 0;
		}
		.vendor:nth-child(3) .vendor__bar {
			margin-left: 0;
		}
		.vendor:nth-child(3)::before {
			display: none;
		}
	}
	@media (max-width: 767px) {
		.strip {
			flex-direction: column;
			gap: 20px;
			padding-top: 24px;
		}
		.strip__cell,
		.strip__cell:first-child {
			padding: 0;
		}
		.strip__cell + .strip__cell {
			border-left: 0;
			padding-top: 20px;
			border-top: 1px solid var(--bone-rule);
		}
		.downloads {
			padding-block: 56px;
			gap: 36px;
		}
		.split,
		.tailnet {
			padding-block: 64px;
		}
		.vendors {
			gap: 36px;
		}
		.vendors__list {
			grid-template-columns: 1fr;
		}
		.vendor,
		.vendor + .vendor {
			padding: 0;
		}
		.vendor + .vendor .vendor__bar {
			margin-left: 0;
		}
