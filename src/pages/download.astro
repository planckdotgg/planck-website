---
import CopyButton from '../components/CopyButton.astro';
import LauncherPreview from '../components/LauncherPreview.astro';
import Base from '../layouts/Base.astro';
import { BUILD_POSIX, BUILD_POWERSHELL, RELEASES, REPO } from '../lib/site';

const steps = [
	{
		title: 'Get the binaries',
		body: 'Build bin/planck-host and bin/planck-client from source today. Prebuilt installers arrive with the first GitHub Release.',
	},
	{
		title: 'Launch planck-client and turn on Hosting',
		body: 'On the machine you want to reach, open planck-client and switch on Hosting at the bottom of the rail. Prefer a terminal or a headless box? Run bin/planck-host instead.',
	},
	{
		title: 'Pair and connect',
		body: 'On the other machine, open planck-client and click the host card. Own Tailscale devices trust each other through LocalAPI WhoIs; on LAN, type the 6-digit PIN once. Planck prefers LAN direct and steps to Tailscale automatically.',
	},
];

const platforms = [
	{
		name: 'Windows',
		tag: 'x64 · Pure Go',
		rows: [
			['Encoders', 'NVENC (H.264, HEVC, AV1) · AMF · Intel oneVPL'],
			[
				'Color & HDR10',
				'HEVC 4:4:4 host encode (NVENC/oneVPL) · PyroWave LAN 4:4:4 · BT.2020 PQ host encode',
			],
			['LAN codec', 'Optional PyroWave intra-frame wavelet (wired LAN)'],
			['Virtual audio', 'PlanckVAD (WDM/WaveRT · manual install) + WASAPI Opus'],
			['Display & pad', 'Live switching · SudoVDA & ViGEmBus (third-party)'],
			['Networking', 'LAN direct · Native Tailscale LocalAPI & WhoIs · PIN'],
		],
	},
	{
		name: 'macOS',
		tag: 'arm64 & x64 · Pure Go',
		rows: [
			['Encoders', 'Apple VideoToolbox (HEVC Main / Main10 · 4:2:0)'],
			['Color & HDR10', 'macOS client presentation: Metal EDR (HDR10) · Host encode: 4:2:0 only'],
			[
				'Decode',
				'0.87 ms decode p50 (Apple M5 Pro · 1080p120 · docs/spikes/phase0-spike2.md · 2026-11-23) · zero-copy',
			],
			['Virtual audio', 'PlanckAudio.driver (CoreAudio HAL · manual install)'],
			['Display & pad', 'Live switching · Pure-Go IOHIDManager gamepad client'],
			['Networking', 'LAN direct · Native Tailscale LocalAPI & WhoIs · PIN'],
		],
	},
];

const bench = [
	{ state: 'Planned', name: 'Linux Host & Client', body: 'Pure-Go native Linux build.' },
	{ state: 'Planned', name: 'iOS, iPad & Apple TV', body: 'Native Apple clients.' },
	{ state: 'Planned', name: 'Android TV', body: 'Living-room client.' },
	{ state: 'Not available', name: 'Web Browser', body: 'Native GPU present only.' },
];
---

<Base
	title="Download Planck: Windows & macOS, or build from source"
	description="Get Planck's pure-Go planck-host and planck-client for Windows and macOS. Build from source today with Go 1.27.4+; release downloads appear automatically when published."
	active="download"
>
	<section class="hero">
		<div class="wrap">
			<div class="chip-row">
				<span class="chip">Download · Windows & macOS</span>
				<span class="chip-text">Go 1.27.4+ · CGO_ENABLED=0 · Apache-2.0</span>
			</div>
			<div class="hero__row">
				<div>
					<h1 class="display h1 hero__title">Download Planck.</h1>
					<p class="lead hero__sub">
						Native pure-Go <code>planck-host</code> and <code>planck-client</code> for Windows and
						macOS. Zero Rust, zero Electron, zero account required.
					</p>
				</div>
				<a class="btn btn--ghost hero__repo" href={REPO} rel="noopener"
					>View repository on GitHub <span aria-hidden="true">↗</span></a
				>
			</div>

			<div class="get">
				<article class="card get__os" data-os="windows">
					<div class="get__os-head">
						<h2 class="display get__os-name">Windows</h2>
						<span class="chip chip--plain chip--square">x64 · Pure Go</span>
					</div>
					<p class="body2">Host and client. NVENC, AMF, or oneVPL encode.</p>
					<a class="btn btn--primary get__btn" href="/api/download?platform=windows"
						>Download for Windows</a
					>
					<p class="get__mine mono" hidden>Matches this machine</p>
				</article>
				<article class="card get__os" data-os="macos">
					<div class="get__os-head">
						<h2 class="display get__os-name">macOS</h2>
						<span class="chip chip--plain chip--square">arm64 & x64 · Pure Go</span>
					</div>
					<p class="body2">Host and client. VideoToolbox encode, Metal EDR HDR10 presentation.</p>
					<a class="btn btn--primary get__btn" href="/api/download?platform=macos"
						>Download for macOS</a
					>
					<p class="get__mine mono" hidden>Matches this machine</p>
				</article>
				<article class="card get__check" data-machine-check>
					<div class="get__os-head">
						<h2 class="get__check-title">Check this machine</h2>
						<span class="chip chip--direct chip--square">Local only</span>
					</div>
					<p class="body2">
						Reads your OS and GPU in this browser to pick the right build. Nothing is sent anywhere.
					</p>
					<button type="button" class="btn btn--ghost get__btn" data-check-run>Check this machine</button>
					<dl class="get__result mono" data-check-result hidden>
						<dt>OS</dt>
						<dd data-check="os"></dd>
						<dt>GPU</dt>
						<dd data-check="gpu"></dd>
						<dt>Encoder</dt>
						<dd data-check="enc"></dd>
					</dl>
					<p class="get__verdict" data-check-verdict role="status"></p>
				</article>
			</div>

			<div class="card card--dashed get__note">
				<span class="chip chip--relay chip--square">No release yet</span>
				<p>
					The first prebuilt installers (macOS Apple Silicon / Intel · Windows x64) arrive with v0.4 on
					GitHub Releases. The buttons above fetch them automatically once published; until then they
					open the Releases page.
				</p>
				<a class="link link--mono link--quiet" href={RELEASES} rel="noopener"
					>Watch GitHub Releases <span aria-hidden="true">↗</span></a
				>
			</div>

			<div class="src" id="source">
				<div class="src__head">
					<h2 class="display h3">Build from source today.</h2>
					<p class="meta">Tested on main · Go 1.27.4+ · CGO_ENABLED=0</p>
				</div>
				<div class="src__grid">
					<div class="term src__card">
						<div class="term__bar">
							<p class="src__shell mono">
								<span class="dot dot--ember"></span><b>macOS / POSIX (zsh / bash)</b>
								<span class="c-muted">Go 1.27.4+</span>
							</p>
							<CopyButton target="dl-posix" ember what="the macOS / POSIX build command" />
						</div>
						<pre><code id="dl-posix">{BUILD_POSIX[0]}
{BUILD_POSIX[1]}
<span class="em">{BUILD_POSIX[2]}</span></code></pre>
						<div class="src__foot mono">
							<span>Outputs bin/planck-host & bin/planck-client</span>
							<span class="c-direct">Tested · main</span>
						</div>
					</div>
					<div class="term src__card">
						<div class="term__bar">
							<p class="src__shell mono">
								<span class="dot dot--ember"></span><b>Windows (PowerShell)</b>
								<span class="c-muted">Go 1.27.4+</span>
							</p>
							<CopyButton target="dl-ps" ember what="the Windows PowerShell build command" />
						</div>
						<pre><code id="dl-ps">{BUILD_POWERSHELL[0]}
{BUILD_POWERSHELL[1]}
<span class="em">{BUILD_POWERSHELL[2]}</span></code></pre>
						<div class="src__foot mono">
							<span>Outputs bin\planck-host.exe & bin\planck-client.exe</span>
							<span class="c-direct">Tested · main</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section" id="quick-start">
		<div class="wrap qs" data-reveal>
			<div>
				<p class="eyebrow">Quick start · Install before inventory</p>
				<h2 class="display h2">Running in three steps.</h2>
				<ol class="qs__steps" data-steps>
					{
						steps.map((s, i) => (
							<li class="qs__step" data-step-index={i + 1}>
								<button
									type="button"
									class="qs__head"
									aria-expanded="true"
									aria-controls={`qs-body-${i + 1}`}
								>
									<span class="qs__num mono">0{i + 1}</span>
									<span class="qs__title">{s.title}</span>
									<span class="qs__chev" aria-hidden="true" />
								</button>
								<p class="qs__body body2" id={`qs-body-${i + 1}`}>
									{s.body}
								</p>
							</li>
						))
					}
				</ol>
			</div>
			<div class="qs__preview">
				<LauncherPreview />
			</div>
		</div>
	</section>

	<section class="section" id="platforms">
		<div class="wrap" data-reveal>
			<div class="section-head">
				<div>
					<p class="eyebrow">Platforms · Shipped</p>
					<h2 class="display h2">Windows & macOS, both host and client.</h2>
				</div>
				<a class="link link--mono" href="/roadmap"
					>Full capability ledger on /roadmap <span class="arrow" aria-hidden="true">→</span></a
				>
			</div>
			<div class="plat">
				{
					platforms.map((p) => (
						<article class="card plat__card">
							<div class="plat__head">
								<div>
									<h3 class="display plat__name">{p.name}</h3>
									<p class="eyebrow eyebrow--direct">Host + client · Shipped</p>
								</div>
								<span class="chip chip--plain chip--square">{p.tag}</span>
							</div>
							<dl class="plat__rows">
								{p.rows.map(([k, v]) => (
									<div class="plat__row">
										<dt class="mono">{k}</dt>
										<dd>{v}</dd>
									</div>
								))}
							</dl>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" id="drivers">
		<div class="wrap" data-reveal>
			<div class="section-head">
				<div>
					<p class="eyebrow eyebrow--relay">Optional drivers & virtual audio</p>
					<h2 class="display h2">Add only what your rig needs.</h2>
				</div>
				<p class="section-head__aside">
					Planck works out of the box without any driver install. Install these only when you want
					virtual audio, headless displays, or gamepads.
				</p>
			</div>
			<div class="drv">
				<article class="card drv__card">
					<span class="chip chip--direct chip--square">First-party · macOS CoreAudio HAL</span>
					<h3 class="display drv__name">PlanckAudio.driver (macOS)</h3>
					<p class="body2">
						CoreAudio HAL virtual audio plugin for clean isolated host capture without re-routing your
						desktop speakers.
					</p>
					<p class="drv__code mono">
						Manual install into <b>/Library/Audio/Plug-Ins/HAL/</b> and restart <span class="c-direct"
							>coreaudiod</span
						>
					</p>
					<a
						class="link drv__link"
						href={`${REPO}/blob/main/drivers/audio/darwin/README.md`}
						rel="noopener">Read the macOS driver guide <span class="arrow" aria-hidden="true">→</span></a
					>
				</article>
				<article class="card drv__card">
					<span class="chip chip--relay chip--square">First-party · Windows pre-WHQL</span>
					<h3 class="display drv__name">PlanckVAD (Windows)</h3>
					<p class="body2">
						WDM/WaveRT kernel virtual audio driver for isolated host playback until WHQL-signed.
					</p>
					<p class="drv__warn" role="note">
						<b>Spare PC or VM only.</b> Pre-WHQL test-signing lowers kernel code integrity, requires Secure
						Boot off, and needs a reboot.
					</p>
					<a
						class="link drv__link"
						href={`${REPO}/blob/main/drivers/audio/windows/README.md`}
						rel="noopener"
						>Read full install, cert trust & rollback guide <span class="arrow" aria-hidden="true">→</span></a
					>
				</article>
				<article class="card drv__card">
					<span class="chip chip--relay chip--square">Third-party · Windows host</span>
					<h3 class="display drv__name">SudoVDA</h3>
					<p class="body2">
						Adds a headless virtual display on Windows so you can turn off your desk monitor and match
						your client's exact resolution and refresh rate.
					</p>
					<p class="drv__meta mono">
						Windows only · <a href="https://github.com/SudoMaker/SudoVDA" rel="noopener"
							>Get SudoVDA <span aria-hidden="true">↗</span></a
						>
					</p>
				</article>
				<article class="card drv__card">
					<span class="chip chip--relay chip--square">Third-party · Windows host</span>
					<h3 class="display drv__name">ViGEmBus</h3>
					<p class="body2">
						Creates virtual Xbox-class controllers on Windows hosts for Planck's pure-Go IOHIDManager and
						XInput gamepad passthrough.
					</p>
					<p class="drv__meta mono">
						Xbox-class pads · <a href="https://github.com/nefarius/ViGEmBus" rel="noopener"
							>Get ViGEmBus <span aria-hidden="true">↗</span></a
						>
					</p>
				</article>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap" data-reveal>
			<div class="section-head section-head--center">
				<h2 class="display h2">Platforms still on the bench.</h2>
				<a class="link" href="/roadmap"
					>See full status ledger on /roadmap <span class="arrow" aria-hidden="true">→</span></a
				>
			</div>
			<ul class="bench">
				{
					bench.map((b) => (
						<li class:list={['card', 'bench__card', { 'card--dashed': b.state === 'Planned' }]}>
							<p class="eyebrow eyebrow--muted">{b.state}</p>
							<h3 class="bench__name">{b.name}</h3>
							<p class="body2">{b.body}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Base>

<script>
	import { checkMachine } from '../scripts/machine';

	// Quick start: on wide screens every step is open and the one under the pointer or focus
	// lights its part of the launcher; on phones the steps are an accordion.
	const steps = document.querySelector<HTMLElement>('[data-steps]');
	const launcher = document.querySelector<HTMLElement>('[data-launcher]');
	const narrow = matchMedia('(max-width: 900px)');
	if (steps && launcher) {
		const items = [...steps.querySelectorAll<HTMLElement>('.qs__step')];
		const light = (n: string | undefined) => {
			if (n) launcher.dataset.step = n;
			else delete launcher.dataset.step;
			for (const item of items) item.classList.toggle('is-lit', item.dataset.stepIndex === n);
		};
		for (const item of items) {
			const head = item.querySelector<HTMLButtonElement>('.qs__head');
			item.addEventListener('pointerenter', () => light(item.dataset.stepIndex));
			item.addEventListener('focusin', () => light(item.dataset.stepIndex));
			head?.addEventListener('click', () => {
				light(item.dataset.stepIndex);
				if (!narrow.matches) return;
				const open = head.getAttribute('aria-expanded') === 'true';
				for (const other of items) {
					other.querySelector('.qs__head')?.setAttribute('aria-expanded', 'false');
				}
				head.setAttribute('aria-expanded', String(!open));
			});
		}
		steps.addEventListener('pointerleave', () => light(undefined));
		const syncMode = () => {
			items.forEach((item, i) => {
				const open = narrow.matches ? i === 0 : true;
				item.querySelector('.qs__head')?.setAttribute('aria-expanded', String(open));
			});
		};
		narrow.addEventListener('change', syncMode);
		syncMode();
	}

	const check = document.querySelector<HTMLElement>('[data-machine-check]');
	const run = check?.querySelector<HTMLButtonElement>('[data-check-run]');
	run?.addEventListener('click', async () => {
		if (!check) return;
		run.disabled = true;
		const result = await checkMachine();
		const set = (key: string, value: string) => {
			const el = check.querySelector(`[data-check="${key}"]`);
			if (el) el.textContent = value;
		};
		set('os', result.os);
		set('gpu', result.gpu);
		set('enc', result.encoder);
		const dl = check.querySelector<HTMLElement>('[data-check-result]');
		if (dl) dl.hidden = false;
		const verdict = check.querySelector<HTMLElement>('[data-check-verdict]');
		if (verdict) verdict.textContent = result.verdict;
		for (const card of document.querySelectorAll<HTMLElement>('[data-os]')) {
			const mine = card.dataset.os === result.platform;
			card.classList.toggle('is-mine', mine);
			const tag = card.querySelector<HTMLElement>('.get__mine');
			if (tag) tag.hidden = !mine;
		}
		run.textContent = 'Check again';
		run.disabled = false;
	});
</script>

<style>
	.hero {
		padding: 52px 0 88px;
		background:
			radial-gradient(50% 60% at 40% 0%, rgba(255, 122, 31, 0.1), transparent 70%),
			var(--carbon-900);
	}
	.hero__row {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 48px;
		margin-top: 14px;
	}
	.hero__sub {
		margin-top: 10px;
		max-width: 760px;
	}
	.hero__sub code {
		color: var(--bone-50);
		font-size: 0.92em;
	}
	.hero__repo {
		flex: none;
	}

	.get {
		display: grid;
		grid-template-columns: 1fr 1fr 1.1fr;
		gap: 20px;
		margin-top: 32px;
	}
	.get__os,
	.get__check {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 24px;
		transition:
			border-color var(--dur-base) var(--ease-out),
			box-shadow var(--dur-base) var(--ease-out);
	}
	.get__os {
		border-top: 2px solid var(--ember-500);
	}
	.get__os.is-mine {
		border-color: var(--ember-500);
		box-shadow: 0 0 0 1px var(--ember-500);
	}
	.get__os-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}
	.get__os-name {
		font-size: 26px;
		line-height: 32px;
	}
	.get__check-title {
		font-size: 17px;
		font-weight: 600;
		line-height: 32px;
	}
	.get__btn {
		margin-top: auto;
		align-self: flex-start;
	}
	.get__mine {
		font-size: 10px;
		color: var(--ember-300);
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.get__result {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 4px 14px;
		font-size: 11px;
		line-height: 16px;
		padding: 12px 14px;
		border-radius: var(--radius-sm);
		background: var(--carbon-950);
		border: 1px solid var(--carbon-700);
	}
	.get__result[hidden] {
		display: none;
	}
	.get__result dt {
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.get__result dd {
		color: var(--bone-50);
		overflow-wrap: anywhere;
	}
	.get__verdict {
		font-size: 14px;
		line-height: 20px;
		color: var(--bone-300);
	}
	.get__verdict:empty {
		display: none;
	}
	.get__note {
		display: flex;
		align-items: center;
		gap: 18px;
		margin-top: 20px;
		padding: 14px 22px;
		background: transparent;
	}
	.get__note p {
		flex: 1;
		font-size: 14px;
		line-height: 21px;
		color: var(--bone-300);
	}
	.get__note .link {
		flex: none;
		font-size: 11px;
	}

	.src {
		margin-top: 48px;
	}
	.src__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 16px;
	}
	.src__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 20px;
	}
	.src__card {
		border-top: 2px solid var(--ember-500);
	}
	.src__card pre {
		font-size: 11px;
		line-height: 25px;
	}
	.src__shell {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 11px;
	}
	.src__shell b {
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.src__foot {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		padding: 12px 20px;
		border-top: 1px solid var(--carbon-700);
		background: var(--carbon-850);
		font-size: 10.5px;
		color: var(--muted);
	}
	.src__foot .c-direct {
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.qs {
		display: grid;
		grid-template-columns: 1fr 540px;
		gap: 56px;
		align-items: center;
	}
	.qs__steps {
		margin-top: 28px;
		border-top: 1px solid var(--carbon-700);
	}
	.qs__step {
		border-bottom: 1px solid var(--carbon-700);
		padding: 18px 0 18px;
		transition: background-color var(--dur-base) var(--ease-out);
	}
	.qs__step.is-lit .qs__title {
		color: var(--ember-300);
	}
	.qs__head {
		display: grid;
		grid-template-columns: 46px 1fr auto;
		align-items: center;
		width: 100%;
		min-height: 28px;
		text-align: left;
		cursor: default;
	}
	.qs__num {
		font-size: 15px;
		font-weight: 600;
		color: var(--ember-500);
	}
	.qs__title {
		font-size: 17px;
		font-weight: 600;
		transition: color var(--dur-fast) var(--ease-out);
	}
	.qs__body {
		padding: 4px 0 0 46px;
		max-width: 640px;
	}
	.qs__chev {
		display: none;
	}

	.plat {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 24px;
	}
	.plat__card {
		padding: 32px;
	}
