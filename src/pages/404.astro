---
import Base from '../layouts/Base.astro';
---

<Base
	title="Not found · Planck"
	description="This address has no page. Head back to Planck's home, download, or roadmap."
	ogAlt="Planck card: Play like it’s local. Pure Go, 4:4:4, 10-bit HDR10, Tailscale, Apache-2.0."
	noindex
>
	<section class="nf" aria-labelledby="nf-title">
		<div class="wash wash--fill nf__zenith" aria-hidden="true"></div>
		<div class="wash wash--fill nf__aura" aria-hidden="true"></div>
		<div class="nf__inner">
			<p class="nf__code mono">404 · Frame not delivered</p>
			<h1 id="nf-title" class="display h-page">No frame at this address.</h1>
			<p class="lead nf__lead">The page you asked for does not exist, or it moved.</p>
			<div class="nf__actions">
				<a class="btn btn--primary btn--tall" href="/">Back to home</a>
				<a class="btn btn--ghost btn--tall" href="/download">Download</a>
			</div>
		</div>
	</section>
</Base>

<style>
	.nf {
		position: relative;
		overflow: clip;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 560px;
		padding: 96px var(--pad);
		background: var(--ground);
		text-align: center;
	}
	.nf__zenith {
		background: radial-gradient(ellipse 58% 64% at 50% 0% in oklab, #c9d9ff16 0%, #789bff06 46%, #00000000 76%);
	}
	.nf__aura {
		background: radial-gradient(ellipse 46% 60% at 50% 70% in oklab, #ff7a1f2b 0%, #e8650c12 42%, #00000000 76%);
	}
	.nf__inner {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 18px;
		max-width: 640px;
	}
	.nf__code {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		line-height: 16px;
		color: var(--focus);
	}
	.nf__lead {
		max-width: 480px;
	}
	.nf__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 14px;
		padding-top: 10px;
	}
</style>
