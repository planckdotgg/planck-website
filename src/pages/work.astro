---
import PageHero from '../components/PageHero.astro';
import Base from '../layouts/Base.astro';

const specs = [
	{ label: 'CHROMA', value: 'Free 4:4:4 (HEVC on NVIDIA/Intel; PyroWave planned)' },
	{ label: 'DISPLAYS', value: 'Live multi-monitor, headless Windows (SudoVDA)' },
	{ label: 'DISCOVERY', value: 'Tailscale LocalAPI and WhoIs auth' },
	{ label: 'TRANSPORT', value: '1280-byte MTU-safe raw AEAD UDP' },
];
const code = [
	{
		indent: false,
		parts: [
			['kw', 'func'],
			['plain', ' ConfigureSurface(cfg '],
			['kw', '*Encoder'],
			['plain', ') {'],
		],
	},
	{
		indent: true,
		parts: [
			['field', 'cfg.Chroma   = '],
			['str', '"YUV444"'],
		],
	},
	{
		indent: true,
		parts: [
			['field', 'cfg.Codec    = '],
			['kw', '"HEVC_Main444"'],
		],
	},
	{
		indent: true,
		parts: [
			['field', 'cfg.Color    = '],
			['str', '"FullRange"'],
		],
	},
	{
		indent: true,
		parts: [
			['field', 'cfg.BitDepth = '],
			['num', '10'],
		],
	},
	{ indent: false, parts: [['plain', '}']] },
];
const sides = ['subsampled', 'full'] as const;
---

<Base
	title="Work · Planck"
	description="Your workstation, pixel for pixel: free 4:4:4 chroma, live multi-monitor, headless virtual displays, and zero-PIN Tailscale access."
	active="work"
	og="work.png"
	ogAlt="Planck work card: Your desk, anywhere. Text that stays text at 4:4:4. 4:4:4 chroma, multi-monitor, virtual displays, clipboard."
>
	<PageHero
		title="Your workstation, pixel for pixel."
		lead="Free 4:4:4 chroma, virtual displays, and native Tailscale access to your own machines."
		cta={{ href: '/download', label: 'Download Planck' }}
		zenith="radial-gradient(ellipse 60% 66% at 24% 0% in oklab, #C9D9FF1A 0%, #789BFF08 46%, #00000000 76%)"
		zenithHeight={340}
		aura="radial-gradient(ellipse 46% 72% at 78% 54% in oklab, #FF7A1F26 0%, #4CD69B10 46%, #00000000 78%)"
	>
		<svg viewBox="0 0 472 296" role="img" aria-label="Display 01 at 4:4:4 with one-to-one chroma, in front of a headless SudoVDA virtual display.">
			<path d="M16 74 H456 M16 148 H456 M16 222 H456 M118 20 V276 M236 20 V276 M354 20 V276" fill="none" stroke="#F2EFEA0B"></path>
			<rect x="132" y="34" width="312" height="178" rx="8" fill="#12141A" stroke="#2D323E" stroke-width="1.25" stroke-dasharray="5 5"></rect>
			<rect x="28" y="84" width="312" height="178" rx="8" fill="#14171E" stroke="#454B59" stroke-width="1.25"></rect>
			<path d="M28 116 H340" fill="none" stroke="#252933"></path>
			<path d="M184 84 V262 M28 173 H340" fill="none" stroke="#F2EFEA14"></path>
			<circle cx="184" cy="173" r="46" fill="#0A0B0E" stroke="#FF7A1F" stroke-width="1.5"></circle>
			<circle cx="184" cy="173" r="32" fill="none" stroke="#F2EFEA1C"></circle>
			<rect x="166" y="159" width="8" height="28" rx="1.5" fill="#FF5A5A"></rect>
			<rect x="180" y="159" width="8" height="28" rx="1.5" fill="#4CD69B"></rect>
			<rect x="194" y="159" width="8" height="28" rx="1.5" fill="#8FB3FF"></rect>
			<path d="M184 118 V127 M184 219 V228 M129 173 H138 M230 173 H239" fill="none" stroke="#FF7A1F" stroke-width="1.5"></path>
			<path d="M354 116 H426 M354 134 H410 M354 152 H420" fill="none" stroke="#343944" stroke-width="1.5"></path>
			<rect x="354" y="172" width="44" height="6" rx="2" fill="#4CD69B88"></rect>
			<text x="44" y="101" class="svg-mono" font-size="10" letter-spacing="0.4" fill="#8C919B" dominant-baseline="central">DISPLAY 01 · 4:4:4</text>
			<text x="428" y="55" class="svg-mono" font-size="10" letter-spacing="0.4" fill="#6E7480" text-anchor="end" dominant-baseline="central">SudoVDA · HEADLESS</text>
			<text x="158" y="241" class="svg-mono" font-size="10" letter-spacing="0.6" fill="#FFB27A" dominant-baseline="central">1:1 CHROMA</text>
		</svg>
	</PageHero>

	<section class="band" aria-labelledby="specs-title">
		<div class="wash band__warm" aria-hidden="true"></div>
		<div class="wash band__cool" aria-hidden="true"></div>
		<div class="band__head">
			<h2 id="specs-title" class="display h-band">Core workstation specs</h2>
		</div>
		<dl class="ledger">
			{
				specs.map((s) => (
					<div class="ledger__row">
						<dt class="mono">{s.label}</dt>
						<dd>{s.value}</dd>
					</div>
				))
			}
		</dl>
	</section>

	<div class="canvas">
		<section class="beat beat--split chroma" aria-labelledby="chroma-title">
			<div class="wash wash--fill chroma__glow" aria-hidden="true"></div>
			<div class="beat__copy">
				<h2 id="chroma-title" class="display h-beat">Full 4:4:4 chroma, free.</h2>
				<p class="beat-lead">
					HEVC 4:4:4 ships on NVIDIA and Intel today, followed by PyroWave LAN 4:4:4 in Phase 2.
				</p>
				<p class="beat__rule spec-line spec-line--ember">
					4:4:4 · HEVC (Now) · PyroWave LAN (Phase 2)
				</p>
			</div>
			<figure class="split-code" aria-labelledby="split-code-cap">
				{
					sides.map((side) => (
						<div class:list={['split-code__half', `split-code__half--${side}`]} aria-hidden={side === 'subsampled' ? 'true' : undefined}>
							<div class="split-code__card mono">
								<div class="split-code__top">
									<span>chroma_pipeline.go</span>
									<span class="split-code__res">1px hairline · RGB</span>
								</div>
								<div class="split-code__lines">
									{code.map((line) => (
										<p class:list={['split-code__line', { 'is-indent': line.indent }]}>
											{line.parts.map(([kind, text]) => (
												<span class={`c-${kind}`}>{text}</span>
											))}
										</p>
									))}
								</div>
								<div class="split-code__swatches">
									<span class="sw-red" />
									<span class="sw-ember" />
									<span class="sw-green" />
								</div>
							</div>
						</div>
					))
				}
				<span class="split-code__tag split-code__tag--left mono" aria-hidden="true">4:2:0</span>
				<span class="split-code__tag split-code__tag--right mono" aria-hidden="true">4:4:4</span>
				<span class="split-code__divider" aria-hidden="true"></span>
				<figcaption id="split-code-cap" class="sr-only">
					The same Go code at 4:2:0, with color fringes on thin strokes, and at 4:4:4, clean.
				</figcaption>
			</figure>
		</section>

		<section class="beat beat--stack displays" aria-labelledby="displays-title">
			<div class="wash wash--fill displays__glow" aria-hidden="true"></div>
			<div class="beat__head">
				<h2 id="displays-title" class="display h-beat">Physical monitors or headless Windows.</h2>
				<p class="beat-lead">
					Switch live between attached monitors or drive headless Windows virtual displays through
					SudoVDA.
				</p>
			</div>
			<figure class="diagram" style="--min: 760px" tabindex="0" aria-label="Display switching diagram">
				<svg viewBox="0 0 1152 274" role="img" aria-label="planck-host captures display 01 (2560 by 1440 at 144 Hz, active), display 02 (3840 by 2160 at 60 Hz), or a SudoVDA headless virtual display, and planck-client switches between them live without reconnecting.">
					<path d="M180 132 H260" fill="none" stroke="#3A3F49" stroke-width="1.5"></path>
					<path d="M260 66 V198" fill="none" stroke="#3A3F49" stroke-width="1.5"></path>
					<path d="M260 66 H312 M260 198 H312" fill="none" stroke="#3A3F49" stroke-width="1.5"></path>
					<path d="M512 66 H584 M512 198 H584" fill="none" stroke="#3A3F49" stroke-width="1.25" stroke-dasharray="4 4"></path>
					<path d="M512 66 H852" fill="none" stroke="#FF7A1F" stroke-width="1.75"></path>
					<path d="M852 66 V132 H948" fill="none" stroke="#FF7A1F" stroke-width="1.75"></path>
					<path d="M812 198 H896 V148 H948" fill="none" stroke="#4CD69B" stroke-width="1.75" stroke-dasharray="5 5"></path>
					<rect x="16" y="78" width="164" height="108" rx="8" fill="#13151B" stroke="#3A3F49" stroke-width="1.25"></rect>
					<rect x="312" y="18" width="200" height="102" rx="8" fill="#161921" stroke="#FF7A1F" stroke-width="1.5"></rect>
					<path d="M312 46 H512" fill="none" stroke="#282C36"></path>
					<rect x="312" y="148" width="200" height="102" rx="8" fill="#13151B" stroke="#343944" stroke-width="1.25"></rect>
					<path d="M312 176 H512" fill="none" stroke="#242833"></path>
					<rect x="584" y="148" width="228" height="102" rx="8" fill="#101715" stroke="#4CD69B" stroke-width="1.5" stroke-dasharray="6 4"></rect>
					<path d="M584 176 H812" fill="none" stroke="#1F362D"></path>
					<rect x="948" y="78" width="188" height="108" rx="8" fill="#13151B" stroke="#454B59" stroke-width="1.25"></rect>
					<circle cx="948" cy="132" r="4" fill="#FF7A1F"></circle>
					<circle cx="948" cy="148" r="4" fill="#4CD69B"></circle>
					<text x="28" y="116" class="svg-mono" font-size="11.5" font-weight="600" fill="#F2EFEA" dominant-baseline="central">planck-host</text>
					<text x="28" y="139" class="svg-mono" font-size="9.5" fill="#8C919B" dominant-baseline="central">DXGI / SCK capture</text>
					<text x="328" y="33" class="svg-mono" font-size="10.5" font-weight="600" fill="#FFB27A" dominant-baseline="central">DISPLAY 01 · ACTIVE</text>
					<text x="328" y="73" class="svg-ui" font-size="16" font-weight="600" fill="#F2EFEA" dominant-baseline="central">2560 × 1440 · 144 Hz</text>
					<text x="328" y="97" class="svg-mono" font-size="10" fill="#8C919B" dominant-baseline="central">Physical primary</text>
					<text x="328" y="163" class="svg-mono" font-size="10.5" fill="#8C919B" dominant-baseline="central">DISPLAY 02 · ATTACHED</text>
					<text x="328" y="203" class="svg-ui" font-size="16" font-weight="500" fill="#D4D6DC" dominant-baseline="central">3840 × 2160 · 60 Hz</text>
					<text x="328" y="227" class="svg-mono" font-size="10" fill="#6E7480" dominant-baseline="central">Physical secondary</text>
					<text x="600" y="163" class="svg-mono" font-size="10.5" font-weight="600" fill="#4CD69B" dominant-baseline="central">SudoVDA · HEADLESS</text>
					<text x="600" y="203" class="svg-ui" font-size="16" font-weight="600" fill="#F2EFEA" dominant-baseline="central">Virtual Display</text>
					<text x="600" y="227" class="svg-mono" font-size="10" fill="#8C919B" dominant-baseline="central">No monitor attached</text>
					<text x="962" y="116" class="svg-mono" font-size="11.5" font-weight="600" fill="#F2EFEA" dominant-baseline="central">planck-client</text>
					<text x="962" y="139" class="svg-mono" font-size="9.5" fill="#8C919B" dominant-baseline="central">Live display switch</text>
					<text x="600" y="51" class="svg-mono" font-size="10" letter-spacing="0.4" fill="#FFB27A" dominant-baseline="central">ACTIVE STREAM · ZERO RECONNECT</text>
				</svg>
			</figure>
			<p class="beat__foot spec-line">Multi-monitor · Headless Windows · SudoVDA</p>
		</section>

		<section class="beat zero-pin" aria-labelledby="pin-title">
			<div class="wash wash--fill zero-pin__green" aria-hidden="true"></div>
			<div class="wash horizon" aria-hidden="true"></div>
			<div class="zero-pin__grid">
				<figure class="beat__art zero-pin__art">
					<svg viewBox="0 0 596 292" role="img" aria-label="Laptop, a LocalAPI peer, connects to a workstation tailnet host over direct WireGuard; WhoIs verifies the device with no PIN, and packets stay within a 1280-byte MTU with zero fragmentation.">
						<rect x="16" y="72" width="128" height="128" rx="8" fill="#13151B" stroke="#343944" stroke-width="1.25"></rect>
						<rect x="452" y="72" width="128" height="128" rx="8" fill="#13151B" stroke="#343944" stroke-width="1.25"></rect>
						<path d="M144 114 H452" fill="none" stroke="#4CD69B26" stroke-width="12"></path>
						<path d="M144 114 H452" fill="none" stroke="#4CD69B" stroke-width="2"></path>
						<rect x="234" y="96" width="128" height="36" rx="18" fill="#0E1513" stroke="#4CD69B" stroke-width="1.4"></rect>
						<path d="M144 164 H452" fill="none" stroke="#242833"></path>
						<rect x="162" y="154" width="38" height="20" rx="3" fill="#1A2C26" stroke="#4CD69B66"></rect>
						<rect x="208" y="154" width="38" height="20" rx="3" fill="#1E382F" stroke="#4CD69B88"></rect>
						<rect x="254" y="154" width="38" height="20" rx="3" fill="#24483B" stroke="#4CD69BAA"></rect>
						<rect x="300" y="154" width="38" height="20" rx="3" fill="#2A5848" stroke="#4CD69BCC"></rect>
						<rect x="346" y="154" width="38" height="20" rx="3" fill="#1E382F" stroke="#4CD69B88"></rect>
						<rect x="392" y="154" width="38" height="20" rx="3" fill="#1A2C26" stroke="#4CD69B66"></rect>
						<path d="M162 204 H430" fill="none" stroke="#3A3F49"></path>
						<path d="M162 198 V210 M430 198 V210" fill="none" stroke="#5A606C"></path>
						<circle cx="144" cy="114" r="3.5" fill="#4CD69B"></circle>
						<circle cx="452" cy="114" r="3.5" fill="#4CD69B"></circle>
						<text x="32" y="117" class="svg-ui" font-size="14" font-weight="600" fill="#F2EFEA" dominant-baseline="central">Laptop</text>
						<text x="32" y="139" class="svg-mono" font-size="10" fill="#8C919B" dominant-baseline="central">LocalAPI peer</text>
						<text x="468" y="117" class="svg-ui" font-size="14" font-weight="600" fill="#F2EFEA" dominant-baseline="central">Workstation</text>
						<text x="468" y="139" class="svg-mono" font-size="10" fill="#8C919B" dominant-baseline="central">Tailnet host</text>
						<text x="298" y="114" class="svg-mono" font-size="10.5" font-weight="600" letter-spacing="0.3" fill="#4CD69B" text-anchor="middle" dominant-baseline="central">WhoIs verified</text>
						<text x="296" y="225" class="svg-mono" font-size="10" letter-spacing="0.4" fill="#8C919B" text-anchor="middle" dominant-baseline="central">1280-BYTE MTU · ZERO FRAGMENTATION</text>
						<text x="296" y="63" class="svg-mono" font-size="10" letter-spacing="0.4" fill="#6E7480" text-anchor="middle" dominant-baseline="central">DIRECT WIREGUARD · NO PIN</text>
					</svg>
				</figure>
				<div class="beat__copy">
					<h2 id="pin-title" class="display h-beat">Zero-PIN Tailscale access.</h2>
					<p class="beat-lead">
						LocalAPI discovers your tailnet hosts automatically, WhoIs verifies your own devices,
						and packets stay inside the 1280-byte MTU.
					</p>
				</div>
			</div>
		</section>
	</div>
</Base>

<style>
	.ledger {
		position: relative;
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--bone-rule);
	}
	.ledger__row {
		display: flex;
		align-items: baseline;
		gap: 48px;
		padding-block: 28px;
		border-bottom: 1px solid var(--bone-rule);
	}
	.ledger dt {
		flex-shrink: 0;
		width: 220px;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.06em;
		line-height: 20px;
		color: var(--bone-label);
	}
	.ledger dd {
		font-size: clamp(17px, 1.46vw, 21px);
		font-weight: 500;
		letter-spacing: -0.015em;
		line-height: 1.43;
		color: var(--bone-ink);
	}

	.chroma {
		padding: 144px var(--pad) 128px;
	}
	.chroma__glow {
		background: radial-gradient(ellipse 46% 64% at 74% 50% in oklab, #ff7a1f20 0%, #ffb46b0b 44%, #00000000 76%);
	}
	.split-code {
		position: relative;
		flex-shrink: 0;
		width: 596px;
		max-width: 100%;
		aspect-ratio: 596 / 372;
		overflow: clip;
		border-radius: 10px;
		border: 1px solid #2f3440;
		background: #090a0e;
		box-shadow: #000000b8 0 24px 64px;
		container-type: inline-size;
	}
	.split-code__half {
		position: absolute;
		inset: 0;
	}
	.split-code__half--subsampled {
		clip-path: inset(0 50% 0 0);
	}
	.split-code__half--full {
		clip-path: inset(0 0 0 50%);
	}
	.split-code__card {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 16px;
		padding-inline: 13.9cqi;
		font-size: 12px;
		line-height: 22px;
	}
	.split-code__top {
		display: flex;
		justify-content: space-between;
		padding-bottom: 12px;
		border-bottom: 1px solid #222631;
		font-size: 11px;
		line-height: 14px;
		color: var(--text-3);
	}
	.split-code__top span:first-child {
		letter-spacing: 0.04em;
	}
	.split-code__half--full .split-code__res {
		color: var(--text);
	}
	.split-code__lines {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.split-code__line {
		white-space: pre;
		color: #c2c5ce;
	}
	.split-code__line.is-indent {
		padding-left: 18px;
	}
	.c-field {
		color: #d4d6dc;
	}
	.split-code__swatches {
		display: flex;
		gap: 18px;
		padding-top: 14px;
		border-top: 1px solid #222631;
	}
	.split-code__swatches span {
		width: 84px;
		height: 2px;
	}
	.split-code__half--full .c-kw,
	.split-code__half--full .c-num {
		color: var(--accent);
	}
	.split-code__half--full .c-str {
		color: var(--direct);
	}
	.split-code__half--full .sw-red {
		background: var(--fault);
	}
	.split-code__half--full .sw-ember {
		background: var(--accent);
	}
	.split-code__half--full .sw-green {
		background: var(--direct);
	}
	.split-code__half--subsampled .c-kw {
		color: #d9783b;
		text-shadow:
			#782e0e73 1px 0 0,
			#782e0e59 -1px 0 0;
	}
	.split-code__half--subsampled .c-num {
		color: #e38952;
		text-shadow:
			#782e0e73 1px 0 0,
			#782e0e59 -1px 0 0;
	}
	.split-code__half--subsampled .c-str {
		color: #58b88e;
		text-shadow:
			#185c4073 1px 0 0,
			#185c4059 -1px 0 0;
	}
	.split-code__half--subsampled .sw-red {
		background: #d95a5a;
		box-shadow:
			#78181873 1px 0 0,
			#78181859 -1px 0 0;
	}
	.split-code__half--subsampled .sw-ember {
		background: #d9783b;
		box-shadow:
			#782e0e73 1px 0 0,
			#782e0e59 -1px 0 0;
	}
	.split-code__half--subsampled .sw-green {
		background: #58b88e;
		box-shadow:
			#185c4073 1px 0 0,
			#185c4059 -1px 0 0;
	}
	.split-code__tag {
		position: absolute;
		top: 20px;
		font-size: 10.5px;
		font-weight: 500;
		letter-spacing: 0.06em;
		line-height: 14px;
		color: var(--text-3);
	}
	.split-code__tag--left {
		left: 37.6%;
	}
	.split-code__tag--right {
		left: 53.4%;
		font-weight: 600;
		color: var(--focus);
	}
	.split-code__divider {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 50%;
		width: 1px;
		margin-left: -0.5px;
		background: var(--accent);
	}
	@container (max-width: 480px) {
		.split-code__card {
			gap: 10px;
			padding-inline: 7cqi;
			font-size: 10px;
			line-height: 18px;
		}
		.split-code__lines {
			gap: 4px;
		}
		.split-code__top {
			font-size: 9px;
		}
		.split-code__swatches span {
			width: 60px;
		}
	}

	.displays {
		gap: 56px;
	}
	.displays__glow {
		background: radial-gradient(ellipse 60% 54% at 54% 58% in oklab, #4cd69b14 0%, #ff7a1f10 48%, #00000000 76%);
	}

	.zero-pin {
		padding: 120px var(--pad) 156px;
	}
	.zero-pin__green {
		background: radial-gradient(ellipse 46% 56% at 28% 42% in oklab, #4cd69b1a 0%, #4cd69b06 44%, #00000000 76%);
	}
	.zero-pin__grid {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 72px;
	}
	.zero-pin__art {
		width: 596px;
	}

	@media (max-width: 1199px) {
		.zero-pin__grid {
			flex-direction: column-reverse;
			align-items: flex-start;
			gap: 48px;
		}
		.split-code,
		.zero-pin__art {
			align-self: center;
		}
	}
	@media (max-width: 767px) {
		.ledger__row {
