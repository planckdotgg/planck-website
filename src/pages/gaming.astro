---
import PageHero from '../components/PageHero.astro';
import Base from '../layouts/Base.astro';

const sdr = [
	'#100B09',
	'#21120B',
	'#36190B',
	'#4F230B',
	'#6E300C',
	'#8F400E',
	'#B35212',
	'#D46619',
	'#EB7E2A',
	'#F79A4D',
	'#FDB87B',
	'#FFE0C2',
];
// Slice rows of the timeline: [x, width] of capture, slice, transport, present, in art pixels.
const slices = [
	[148, 270, 452, 602, 112],
	[242, 364, 546, 696, 112],
	[336, 458, 640, 790, 112],
	[430, 552, 734, 884, 156],
];
---

<Base
	title="Gaming · Planck"
	description="Zero-copy game streaming at up to 240 FPS: sub-frame slices, 10-bit HDR10, controller passthrough, and an auto-hiding HUD."
	active="gaming"
	og="gaming.png"
	ogAlt="Planck gaming card: Zero-copy streaming at 240 FPS. NVENC 1.04 ms p50, first slice 0.70 ms."
>
	<PageHero
		title="Zero-copy streaming at 240 FPS."
		lead="Sub-frame slices, 10-bit HDR10, and low-jitter pacing targeting 3.6 ms on LAN."
		cta={{ href: '/download', label: 'Download Planck' }}
		zenith="radial-gradient(ellipse 56% 62% at 24% 0% in oklab, #C9D9FF16 0%, #789BFF06 46%, #00000000 76%)"
		aura="radial-gradient(ellipse 50% 76% at 76% 52% in oklab, #FF7A1F36 0%, #E8650C16 40%, #00000000 76%)"
	>
		<svg viewBox="0 0 472 306" role="img" aria-label="A 240 Hz frame of 4.16 ms split into slices: slice 1 presented, slice 2 decoded, slice 3 in flight at 0.7 ms.">
			<rect x="28" y="34" width="416" height="224" rx="10" fill="#12141A" stroke="#303540" stroke-width="1.25"></rect>
			<path d="M132 34 V258 M236 34 V258 M340 34 V258" fill="none" stroke="#F2EFEA0B"></path>
			<rect x="44" y="54" width="384" height="22" rx="3" fill="#1B1E26" stroke="#2B303B"></rect>
			<rect x="44" y="84" width="384" height="22" rx="3" fill="#232227" stroke="#593A27"></rect>
			<rect x="44" y="84" width="328" height="22" rx="3" fill="#FF891224"></rect>
			<rect x="44" y="114" width="384" height="26" rx="3" fill="#FF7A1F"></rect>
			<rect x="336" y="114" width="92" height="26" rx="3" fill="#FFB27A"></rect>
			<rect x="44" y="148" width="384" height="22" rx="3" fill="#1B1E26" stroke="#2D323E"></rect>
			<rect x="44" y="148" width="186" height="22" rx="3" fill="#FFB46B22"></rect>
			<rect x="44" y="178" width="384" height="22" rx="3" fill="#171A21" stroke="#252933"></rect>
			<rect x="44" y="208" width="384" height="22" rx="3" fill="#15181E" stroke="#22252E"></rect>
			<path d="M14 127 H42 M430 127 H458" fill="none" stroke="#FF7A1F" stroke-width="1.5"></path>
			<path d="M28 274 H444" fill="none" stroke="#2C3038"></path>
			<path d="M28 269 V279 M132 269 V279 M236 269 V279 M340 269 V279 M444 269 V279" fill="none" stroke="#5A606C"></path>
			<rect x="28" y="272" width="104" height="4" rx="2" fill="#FF7A1F"></rect>
			<text x="56" y="127" class="svg-mono" font-size="10.5" font-weight="600" letter-spacing="0.42" fill="#1A0B02" dominant-baseline="central">SLICE 03 · IN FLIGHT</text>
			<text x="418" y="127" class="svg-mono" font-size="10" font-weight="600" fill="#1A0B02" text-anchor="end" dominant-baseline="central">0.7 ms</text>
			<text x="56" y="65" class="svg-mono" font-size="10" fill="#8C919B" dominant-baseline="central">SLICE 01 · PRESENTED</text>
			<text x="56" y="95" class="svg-mono" font-size="10" fill="#FFB46B" dominant-baseline="central">SLICE 02 · DECODED</text>
			<text x="28" y="291" class="svg-mono" font-size="10" fill="#6E7480" dominant-baseline="central">0 ms</text>
			<text x="444" y="291" class="svg-mono" font-size="10" fill="#FFB27A" text-anchor="end" dominant-baseline="central">4.16 ms · 240 Hz</text>
		</svg>
	</PageHero>

	<section class="band lab" aria-labelledby="lab-title">
		<div class="wash band__warm lab__warm" aria-hidden="true"></div>
		<div class="wash band__cool" aria-hidden="true"></div>
		<div class="band__head">
			<h2 id="lab-title" class="display h-band">Measured in the lab</h2>
		</div>
		<dl class="metrics metrics--lab">
			<div class="metric">
				<dt class="metric__label">NVENC HEVC encode p50 (RTX 4080, 1080p120 synth)</dt>
				<dd class="metric__value">1.41<span class="metric__unit"> ms</span></dd>
			</div>
			<div class="metric">
				<dt class="metric__label">VideoToolbox decode p50 (Apple Silicon, 1080p120)</dt>
				<dd class="metric__value">0.87<span class="metric__unit"> ms</span></dd>
			</div>
			<div class="metric">
				<dt class="metric__label">Allocs/packet on raw AEAD UDP</dt>
				<dd class="metric__value metric__value--zero">0</dd>
			</div>
		</dl>
		<p class="band__foot">AES-128-GCM via QUIC key export with adaptive RS FEC.</p>
	</section>

	<div class="canvas">
		<section class="beat beat--stack slices" aria-labelledby="slices-title">
			<div class="wash wash--fill slices__glow" aria-hidden="true"></div>
			<div class="beat__head">
				<h2 id="slices-title" class="display h-beat">Slices before the frame finishes.</h2>
				<p class="beat-lead">
					Sub-frame slicing and low-jitter pacing drive 120–240 FPS zero-copy presentation on
					Metal and D3D11.
				</p>
			</div>
			<figure class="diagram" style="--min: 760px" tabindex="0" aria-label="Slice timeline">
				<svg viewBox="0 0 1152 296" role="img" aria-label="Four slices each pass capture, sub-frame slice, AEAD UDP, and present in overlapping steps; the last presents by the 3.6 ms target, while a traditional encoder waits for the full frame.">
					<path d="M148 36 V264 M396 36 V264 M644 36 V264 M892 36 V264 M1040 36 V264" fill="none" stroke="#F2EFEA10"></path>
					<path d="M1040 36 V264" fill="none" stroke="#FF7A1F66" stroke-width="1.25" stroke-dasharray="4 4"></path>
					<path d="M148 64 H1136" fill="none" stroke="#F2EFEA0D"></path>
					<rect x="148" y="42" width="980" height="14" rx="2" fill="#181B22" stroke="#282C36"></rect>
					{
						slices.map(([a, b, c, d, w], i) => {
							const y = 88 + i * 42;
							return (
								<g>
									<rect x={a} y={y} width="116" height="24" rx="3" fill="#FF8912" />
									<rect x={b} y={y} width="176" height="24" rx="3" fill="#FFB46B" />
									<rect x={c} y={y} width="144" height="24" rx="3" fill="#FFD1A3" />
									<rect x={d} y={y} width={w} height="24" rx="3" fill="#4CD69B" />
								</g>
							);
						})
					}
					<path d="M148 264 H1136" fill="none" stroke="#2C3038"></path>
					<text x="0" y="49" class="svg-mono" font-size="10.5" fill="#6E7480" dominant-baseline="central">Full-frame wait</text>
					<text x="162" y="49" class="svg-mono" font-size="9.5" fill="#5A606C" dominant-baseline="central">Traditional encoder holds until frame completes</text>
					<text x="0" y="100" class="svg-mono" font-size="11" font-weight="500" fill="#F2EFEA" dominant-baseline="central">Slice 1</text>
					<text x="0" y="142" class="svg-mono" font-size="11" fill="#B6B8BE" dominant-baseline="central">Slice 2</text>
					<text x="0" y="184" class="svg-mono" font-size="11" fill="#B6B8BE" dominant-baseline="central">Slice 3</text>
					<text x="0" y="226" class="svg-mono" font-size="11" fill="#B6B8BE" dominant-baseline="central">Slice 4</text>
					<text x="160" y="100" class="svg-mono" font-size="10" font-weight="600" fill="#1A0B02" dominant-baseline="central">Capture</text>
					<text x="282" y="100" class="svg-mono" font-size="10" font-weight="600" fill="#1A0B02" dominant-baseline="central">Sub-frame slice</text>
					<text x="464" y="100" class="svg-mono" font-size="10" font-weight="600" fill="#1A0B02" dominant-baseline="central">AEAD UDP</text>
					<text x="614" y="100" class="svg-mono" font-size="10" font-weight="600" fill="#091811" dominant-baseline="central">Present</text>
					<text x="148" y="281" class="svg-mono" font-size="10" fill="#6E7480" dominant-baseline="central">0 ms</text>
					<text x="396" y="281" class="svg-mono" font-size="10" fill="#6E7480" dominant-baseline="central">1.0 ms</text>
					<text x="644" y="281" class="svg-mono" font-size="10" fill="#6E7480" dominant-baseline="central">2.0 ms</text>
					<text x="892" y="281" class="svg-mono" font-size="10" fill="#6E7480" dominant-baseline="central">3.0 ms</text>
					<text x="1002" y="281" class="svg-mono" font-size="10.5" font-weight="600" fill="#FFB27A" dominant-baseline="central">3.6 ms target</text>
				</svg>
			</figure>
			<p class="beat__foot spec-line">Capture → Sub-frame slice → AEAD UDP → Zero-copy present</p>
		</section>

		<section class="beat beat--split hdr" aria-labelledby="hdr-title">
			<div class="wash wash--fill hdr__glow" aria-hidden="true"></div>
			<figure class="hdr__ramps" aria-labelledby="hdr-cap">
				<div class="ramp">
					<div class="ramp__head mono">
						<span class="ramp__name">8-BIT SDR · REC.709</span>
						<span class="ramp__note">256 levels · visible gradient banding</span>
					</div>
					<div class="ramp__steps" aria-hidden="true">
						{sdr.map((c) => <span style={`background:${c}`} />)}
					</div>
				</div>
				<div class="ramp">
					<div class="ramp__head mono">
						<span class="ramp__name ramp__name--hdr">10-BIT HDR10 · BT.2020 PQ</span>
						<span class="ramp__note ramp__note--hdr">1,024 levels · continuous luminance</span>
					</div>
					<div class="ramp__smooth" aria-hidden="true"></div>
					<div class="ramp__scale mono">
						<span>0 nit</span>
						<span class="ramp__sdr">100 nit SDR</span>
						<span class="ramp__pq">1,000 nit PQ</span>
						<span class="ramp__edr">Metal EDR peak</span>
					</div>
				</div>
				<figcaption id="hdr-cap" class="sr-only">
					An 8-bit SDR ramp shows visible steps; the 10-bit HDR10 ramp is continuous up to the
					Metal EDR peak.
				</figcaption>
			</figure>
			<div class="beat__copy">
				<h2 id="hdr-title" class="display h-beat">True 10-bit HDR10.</h2>
				<p class="beat-lead">
					Direct 10-bit HDR10 output over BT.2020 PQ on Windows and Metal EDR on macOS.
				</p>
				<p class="beat__rule spec-line spec-line--ember">
					NVIDIA NVENC · AMD AMF · Intel oneVPL · Apple VideoToolbox
				</p>
			</div>
		</section>

		<section class="beat hud" aria-labelledby="hud-title">
			<div class="wash wash--fill hud__glow" aria-hidden="true"></div>
			<div class="wash horizon" aria-hidden="true"></div>
			<div class="beat--split hud__grid">
				<div class="beat__copy">
					<h2 id="hud-title" class="display h-beat">Controller in. HUD out of sight.</h2>
					<p class="beat-lead">
						Controller passthrough stays responsive, paired with an auto-hiding corner HUD toggled
						by Ctrl+Alt+H.
					</p>
				</div>
				<figure class="hud__frame" aria-label="Stream view with the corner HUD showing 1080p120, HEVC 10-bit, 3.4 ms, and the Ctrl+Alt+H toggle.">
					<div class="hud__floor" aria-hidden="true"></div>
					<svg viewBox="0 0 596 320" aria-hidden="true" preserveAspectRatio="none">
						<path d="M0 218 H596" fill="none" stroke="#F2EFEA14"></path>
						<path d="M298 218 L12 320 M298 218 L156 320 M298 218 L298 320 M298 218 L440 320 M298 218 L584 320" fill="none" stroke="#FF7A1F1C"></path>
						<path d="M0 244 H596 M0 274 H596 M0 306 H596" fill="none" stroke="#F2EFEA0C"></path>
						<path d="M298 136 V154 M298 176 V194 M268 165 H286 M310 165 H328" fill="none" stroke="#F2EFEA26" stroke-width="1.25"></path>
						<circle cx="298" cy="165" r="2.5" fill="#FF7A1F88"></circle>
						<path d="M24 24 H40 M24 24 V40 M572 296 H556 M572 296 V280 M24 296 H40 M24 296 V280" fill="none" stroke="#F2EFEA1F" stroke-width="1.25"></path>
					</svg>
					<p class="hud__pill mono" aria-hidden="true">
						<span class="hud__strong">1080p120</span><span class="hud__sep">·</span><span>HEVC 10-bit</span><span class="hud__sep">·</span><span class="hud__ms">3.4 ms</span><span class="hud__tail"><span class="hud__sep">·</span><span class="hud__key">Ctrl+Alt+H</span></span>
					</p>
					<p class="hud__note mono" aria-hidden="true">AUTO-HIDE · ZERO CHROME</p>
				</figure>
			</div>
		</section>
	</div>
</Base>

<style>
	.lab {
		gap: 72px;
	}
	.lab__warm {
		background: radial-gradient(
			ellipse 68% 64% at 74% 32% in oklab,
			#ff7a1f24 0%,
			#ffb46b0f 44%,
			#f2efea00 76%
		);
	}
	.slices {
		padding: 144px var(--pad) 128px;
	}
	.slices__glow {
		background: radial-gradient(ellipse 62% 54% at 50% 62% in oklab, #ff7a1f1c 0%, #ffb46b0a 44%, #00000000 76%);
	}
	.hdr__glow {
		background: radial-gradient(ellipse 46% 62% at 28% 52% in oklab, #ff7a1f1e 0%, #ffb46b0c 44%, #00000000 76%);
	}
	.hdr__ramps {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 28px;
		flex-shrink: 0;
		width: 596px;
		max-width: 100%;
	}
	.ramp {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.ramp__head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 4px 16px;
	}
	.ramp__name {
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.05em;
		line-height: 16px;
		color: var(--text-3);
	}
	.ramp__name--hdr {
		font-weight: 600;
		color: var(--focus);
	}
	.ramp__note {
		font-size: 10.5px;
		line-height: 16px;
		color: var(--control-edge);
	}
	.ramp__note--hdr {
		color: var(--text);
	}
	.ramp__steps {
		display: flex;
		height: 52px;
		overflow: clip;
		border-radius: 6px;
		border: 1px solid #262a34;
	}
	.ramp__steps span {
		flex: 1 1 0;
	}
	.ramp__smooth {
		height: 76px;
		border-radius: 6px;
		border: 1px solid #ff7a1f66;
		background: linear-gradient(
			in oklab 90deg,
			#07080a 0%,
			#2c1206 18%,
			#7e2f07 38%,
			#ff7a1f 60%,
			#ffb46b 78%,
			#fff4e6 92%,
			#d4e2ff 100%
		);
		box-shadow: #ff7a1f26 0 10px 36px;
	}
	.ramp__scale {
		display: flex;
		justify-content: space-between;
		gap: 8px;
		padding-top: 10px;
		border-top: 1px solid #232732;
		font-size: 10px;
		line-height: 14px;
		color: var(--control-edge);
	}
	.ramp__sdr {
		color: var(--text-3);
	}
	.ramp__pq {
		font-weight: 600;
		color: var(--focus);
	}
	.ramp__edr {
		color: var(--k10000);
	}

	.hud {
		padding: 120px var(--pad) 156px;
	}
	.hud__glow {
		background: radial-gradient(ellipse 46% 56% at 74% 42% in oklab, #ff7a1f18 0%, #c9d9ff08 46%, #00000000 76%);
	}
	.hud__grid {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 72px;
	}
	.hud__frame {
		position: relative;
		flex-shrink: 0;
		width: 596px;
		max-width: 100%;
		aspect-ratio: 596 / 320;
		overflow: clip;
		border-radius: 10px;
		border: 1px solid #2a2e39;
		background: linear-gradient(in oklab 180deg, #10131a 0%, #090b0f 58%, #131110 100%);
		box-shadow: #000000b0 0 24px 64px;
	}
	.hud__floor {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 59%;
		background: radial-gradient(ellipse 68% 48% at 50% 82% in oklab, #ff7a1f24 0%, #e8650c0a 45%, #00000000 76%);
	}
	.hud__frame svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.hud__pill {
		position: absolute;
		right: 20px;
		top: 20px;
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 8px 16px;
		border-radius: 999px;
		background: #0e0f12e0;
		border: 1px solid #f2efea24;
		box-shadow: #00000088 0 10px 28px;
		font-size: 10.5px;
		line-height: 14px;
		color: var(--text-2);
		white-space: nowrap;
	}
	.hud__strong {
		font-weight: 500;
		color: var(--text);
	}
	.hud__sep {
		color: var(--border-strong);
	}
	.hud__ms {
		font-weight: 600;
		color: var(--accent);
	}
	.hud__tail {
		display: contents;
	}
	.hud__key {
		color: var(--text-3);
	}
	.hud__note {
		position: absolute;
		left: 24px;
		bottom: 20px;
		font-size: 10px;
		letter-spacing: 0.04em;
		line-height: 14px;
		color: #5a606c;
	}

	@media (max-width: 1199px) {
		.hud__grid {
			flex-direction: column;
			align-items: flex-start;
			gap: 48px;
		}
		.hdr {
			flex-direction: column-reverse;
		}
		.hdr__ramps,
		.hud__frame {
			align-self: center;
		}
	}
	@media (max-width: 767px) {
		.lab {
			gap: 28px;
		}
		.slices,
		.hud {
			padding-block: 64px;
		}
		.hud__pill {
			right: 10px;
			top: 10px;
			gap: 6px;
			padding: 6px 10px;
			font-size: 9px;
		}
		.hud__tail {
			display: none;
		}
		.hud__note {
			left: 14px;
			bottom: 12px;
			font-size: 9px;
		}
		.ramp__scale {
			font-size: 9px;
		}
	}
</style>
