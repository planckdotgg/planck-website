---
import { Picture } from 'astro:assets';
import canyon from '../assets/hero-gaming-hdr10@2x.png';
import Mark from '../components/Mark.astro';
import Base from '../layouts/Base.astro';

const features = [
	{
		title: 'Zero port forwarding',
		body: 'Reach your gaming PC across your tailnet without touching router rules.',
	},
	{
		title: 'LAN-first routing',
		body: 'Automatically prefers local subnet over Tailscale whenever both machines are home.',
	},
	{
		title: 'Inline PIN & WhoIs trust',
		body: 'Own Tailscale devices connect with zero PIN; LAN peers pin certs inline.',
	},
];

const inputs = [
	{
		tag: 'Shipped · Windows & macOS',
		tone: 'direct',
		title: 'Raw Mouse, Keyboard & Chords',
		body: 'Physical key positions pass straight through, with rebindable hotkeys for HUD toggle, display switch, and Ctrl+Alt+Del.',
	},
	{
		tag: 'ViGEmBus · Windows host',
		tone: 'relay',
		title: 'Plug-and-Play Controllers',
		body: 'Native controller capture on macOS and Windows with built-in mapping. Virtual Xbox-class host pads via ViGEmBus.',
	},
	{
		tag: 'First-party · Manual install',
		tone: 'muted',
		title: 'Low-Latency Stereo Audio',
		body: '20 ms Opus loopback out of the box, plus optional first-party virtual audio drivers to keep room speakers quiet.',
	},
];

const SCALE_MS = 4;
const gpus = [
	{
		name: 'NVIDIA RTX 4080',
		enc: 'NVENC HEVC · Pure Go',
		encode: 1.41,
		e2e: 1.71,
		bar: 'var(--ember-500)',
	},
	{
		name: 'Intel UHD 770',
		enc: 'oneVPL VDEnc HEVC · Pure Go',
		encode: 2.31,
		e2e: 2.72,
		bar: 'var(--k3000)',
	},
	{
		name: 'AMD RX 6700 XT',
		enc: 'AMF HEVC · Pure Go',
		encode: 3.04,
		e2e: 3.37,
		bar: 'var(--k4000)',
	},
];
---

<Base
	title="Planck for gaming: your GPU stays at the desk"
	description="Stream your gaming rig to a laptop or couch over LAN or Tailscale. Up to 240 Hz paced output where supported, HDR10 host encode, pure-Go gamepads, and zero subscription."
	active="gaming"
	og="gaming.jpg"
>
	<section class="hero">
		<div class="wrap">
			<div class="chip-row">
				<span class="chip chip--direct">Gaming · Apache-2.0</span>
				<span class="chip-text"
					>Up to 240 Hz paced (hardware-dependent) · NVENC sub-frame slices · HDR10 BT.2020 PQ</span
				>
			</div>
			<div class="hero__row">
				<div>
					<h1 class="display h1 hero__title">Your GPU stays at the desk. You don't have to.</h1>
					<p class="lead hero__sub">
						Stream your gaming rig to a laptop or couch over LAN or Tailscale. Up to 240 Hz paced
						output where supported, pure-Go gamepads, and zero subscription.
					</p>
				</div>
				<div class="hero__buttons">
					<a class="btn btn--primary btn--lg" href="/download">Download Planck</a>
					<a class="btn btn--ghost btn--lg" href="#bench">Latency numbers</a>
				</div>
			</div>

			<figure class="show" data-hud-root>
				<div class="show__screen" data-hud-area>
					<Picture
						src={canyon}
						alt="Illustration: an obsidian volcanic canyon with molten ember fissures under twilight light shafts."
						widths={[640, 960, 1248, 1920, 2492]}
						sizes="(max-width: 1440px) calc(100vw - 48px), 1248px"
						formats={['avif', 'webp']}
						fallbackFormat="jpg"
			quality={78}
						loading="eager"
						fetchpriority="high"
						class="show__img"
					/>
					<div class="show__vignette" aria-hidden="true"></div>
					<div class="hud-hair" aria-hidden="true"></div>
					<div class="show__hud hud-float">
						<button type="button" class="hud show__pill" aria-pressed="false" data-hud-pill title="Pin the HUD">
							<span class="hud__badge">Illustrative HUD</span>
							<span class="show__host"><span class="dot dot--direct"></span>DESK-RIG · LAN</span>
							<span class="hud__sep" aria-hidden="true"></span>
							<span class="c-ember-soft show__hdr">HDR10 · BT.2020 PQ</span>
							<span class="hud__sep show__wide" aria-hidden="true"></span>
							<span class="c-muted show__wide">1440p · 240 Hz · Auto-hides (⌃⌥H)</span>
							<span class="sr-only" data-hud-pin-state>Click to pin.</span>
						</button>
					</div>
					<p class="show__hint mono" aria-hidden="true">HUD auto-hides after 6 s · Hover the top edge or press Ctrl+Alt+H · Click to pin</p>
				</div>
				<figcaption class="show__cap mono">
					<span
						><b>SDR illustration of the HDR10 path</b> · NVENC/AMF/oneVPL BT.2020 PQ host → macOS Metal EDR
						client</span
					>
					<span class="c-muted">Windows client HDR10 planned</span>
				</figcaption>
			</figure>
		</div>
	</section>

	<section class="section">
		<div class="wrap client" data-reveal>
			<div>
				<p class="eyebrow">Desktop client · Native UI</p>
				<h2 class="display h2">Open the app. Click the rig.</h2>
				<p class="lead client__lead">
					Switch hosts, check live frame timing, or pair a rig in two clicks, with native GPU
					presentation and zero Electron bloat.
				</p>
				<ul class="client__features">
					{
						features.map((f) => (
							<li>
								<h3>{f.title}</h3>
								<p class="body2">{f.body}</p>
							</li>
						))
					}
				</ul>
			</div>
			<figure class="card app" aria-label="Planck desktop client, Hosts view (demo UI)">
				<div class="app__rail" aria-hidden="true">
					<Mark size={28} />
					<span class="app__icon app__icon--on"
						><svg viewBox="0 0 24 24" width="20" height="20"
							><path d="M4 5h16v11H4z M9 20h6 M12 16v4" fill="none" stroke="currentColor" stroke-width="1.6"
							></path></svg
						></span
					>
					<span class="app__icon"
						><svg viewBox="0 0 24 24" width="20" height="20"
							><path
								d="M4.5 4v15.5h15.5 M7 15l3.5-4 3 2.5 4.5-6"
								fill="none"
								stroke="currentColor"
								stroke-width="1.6"></path></svg
						></span
					>
					<span class="app__icon"
						><svg viewBox="0 0 24 24" width="20" height="20"
							><path
								d="M4 7h10 M18 7h2 M4 17h4 M12 17h8 M16 5v4 M10 15v4"
								fill="none"
								stroke="currentColor"
								stroke-width="1.6"></path></svg
						></span
					>
					<span class="app__spacer"></span>
					<span class="app__icon app__icon--host"
						><svg viewBox="0 0 24 24" width="20" height="20"
							><path
								d="M12 13v7 M8.5 10.5a5 5 0 0 1 7 0 M5.5 7.5a9 9 0 0 1 13 0"
								fill="none"
								stroke="currentColor"
								stroke-width="1.6"></path><circle cx="12" cy="13" r="1.4" fill="currentColor"
							></circle></svg
						></span
					>
				</div>
				<div class="app__main">
					<div class="app__head">
						<p class="display app__title">Hosts</p>
						<p class="mono c-direct app__status">2 online · Tailscale ready</p>
					</div>
					<div class="app__search">
						<p class="mono app__input"><span class="c-muted">&gt;</span> desk-rig.local<i></i></p>
						<span class="mono c-muted app__hint">address · name · peer ID</span>
						<span class="app__btn app__btn--ember">Connect</span>
					</div>
					<div class="app__host app__host--pair">
						<div class="app__row">
							<p class="app__name">DESK-RIG</p>
							<span class="chip chip--square">Pairing inline · LAN direct</span>
							<span class="app__cancel">Cancel</span>
						</div>
						<p class="mono app__meta">Windows · RTX 4080 · HEVC 10-bit · 2.5 GbE</p>
						<div class="app__pin">
							<div>
								<p class="app__pin-label">Enter the 6-digit PIN displayed on DESK-RIG</p>
								<p class="app__digits mono">
									<i>4</i><i>8</i><i>2</i><b>–</b><i>9</i><i>1</i><i class="on">7</i>
								</p>
							</div>
							<div class="app__pin-end">
								<p class="mono c-muted app__cert">TLS cert pinned on pair</p>
								<span class="app__btn app__btn--ember">Pair & Connect</span>
							</div>
						</div>
					</div>
					<div class="app__host">
						<div class="app__row">
							<div>
								<p class="app__row app__row--start">
									<span class="app__name">STUDIO-MAC</span>
									<span class="chip chip--direct chip--square">Tailscale direct · WhoIs</span>
								</p>
								<p class="mono app__meta">macOS · Apple M5 Pro · VideoToolbox · 1152 B</p>
							</div>
							<span class="app__btn">Connect</span>
						</div>
					</div>
					<div class="app__host app__host--off">
						<div class="app__row">
							<div>
								<p class="app__row app__row--start">
									<span class="app__name">DEN-PC</span>
									<span class="chip chip--fault chip--square">Unreachable</span>
								</p>
								<p class="mono app__meta">Offline · Last seen 4h ago</p>
							</div>
							<span class="c-muted" aria-hidden="true">–</span>
						</div>
					</div>
				</div>
				<figcaption class="sr-only">
					Demo UI. DESK-RIG is pairing inline with a 6-digit PIN over LAN; STUDIO-MAC is reachable
					through Tailscale WhoIs; DEN-PC is offline.
				</figcaption>
			</figure>
		</div>
	</section>

	<section class="section">
		<div class="wrap" data-reveal>
			<p class="eyebrow">Input, gamepads & audio</p>
			<h2 class="display h2">Mouse, keyboard, pads, and audio, passed straight through.</h2>
			<div class="inputs">
				{
					inputs.map((i) => (
						<article>
							<p class={`eyebrow eyebrow--${i.tone}`}>{i.tag}</p>
							<h3 class="inputs__title">{i.title}</h3>
							<p class="body2">{i.body}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" id="bench">
		<div class="wrap" data-reveal>
			<div class="section-head">
				<div>
					<p class="eyebrow">Multi-vendor GPU bench</p>
					<h2 class="display h2">Three GPU vendors, one workload.</h2>
				</div>
				<p class="section-head__aside">
					Identical 1080p120 synthetic loopback runs on Windows (TestLiveSynthHardware · 2026-11-23).
					Headless host → decode excludes display present.
				</p>
			</div>
			<div class="card bench">
				<table>
					<caption class="sr-only">
						Host encode p50 and headless host to decode p50 per GPU, 1080p120 synthetic load,
						TestLiveSynthHardware, 2026-11-23
					</caption>
					<thead>
						<tr>
							<th scope="col">GPU & encoder</th>
							<th scope="col" class="bench__barcol">Host encode p50 (1080p120 synth)</th>
							<th scope="col" class="num">Encode p50</th>
							<th scope="col" class="num bench__e2e">Headless host → decode p50</th>
						</tr>
					</thead>
					<tbody>
						{
							gpus.map((g) => (
								<tr>
									<th scope="row">
										<span class="bench__gpu">{g.name}</span>
										<span class="bench__enc mono">{g.enc}</span>
									</th>
									<td class="bench__barcol" aria-hidden="true">
										<span class="bench__track">
											<span
												class="bench__bar"
												style={`width:${(g.encode / SCALE_MS) * 100}%;background:${g.bar}`}
											/>
										</span>
									</td>
									<td class="num">
										<span class:list={['display', 'bench__fig', { 'c-ember': g.encode < 2 }]}>
											{g.encode.toFixed(2)}
										</span>
										<span class="unit bench__unit">ms</span>
									</td>
									<td class="num bench__e2e">
										<span class="display bench__fig2">{g.e2e.toFixed(2)}</span>
										<span class="unit bench__unit">ms</span>
										<span class="bench__note mono">excludes display present</span>
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
				<div class="bench__foot mono">
					<span>TestLiveSynthHardware · Windows loopback · 1080p120 synthetic load · 2026-11-23</span>
					<span>Bars scaled to 4.0 ms · Lower is faster</span>
				</div>
			</div>

			<div class="card tail">
				<div>
					<p class="eyebrow">Separate workload · 1080p240 paced tail (boosted + MMCSS)</p>
					<p class="tail__title">
						RTX 4080 NVENC HEVC paced encode p99: <span class="mono c-ember tail__fig">1.55 ms</span> (max
						2.3 ms)
					</p>
					<p class="meta">
						Encode stage only · NVAPI P0 boost + Windows MMCSS Games thread · branch phase1b/qa-fixes
						(0fd1833) · 2026-11-23
					</p>
				</div>
				<span class="chip chip--plain chip--square tail__pill">240 Hz paced ≠ 120 Hz synth above</span>
			</div>

			<div class="card disp" data-display-switch>
				<div class="disp__copy">
					<h3 class="disp__title">Live display switching & headless SudoVDA virtual displays</h3>
					<p class="body2">
						Switch the active display mid-session; optional SudoVDA virtual display on Windows.
					</p>
					<div class="seg disp__seg" role="tablist" aria-label="Display source">
						<button
							class="seg__btn"
							role="tab"
							id="disp-tab-phys"
							aria-selected="true"
							aria-controls="disp-phys"
							tabindex="0"><span class="dot dot--ember"></span>Physical display</button
						>
						<button
							class="seg__btn"
							role="tab"
							id="disp-tab-virt"
							aria-selected="false"
							aria-controls="disp-virt"
							tabindex="-1"><span class="dot dot--ember"></span>Virtual display (SudoVDA)</button
						>
					</div>
				</div>
				<div class="disp__panels">
					<div class="disp__panel" id="disp-phys" role="tabpanel" aria-labelledby="disp-tab-phys">
						<div class="disp__diagram" aria-hidden="true">
							<span class="disp__screen is-on"><b>Desk monitor</b><i>active</i></span>
							<span class="disp__link"></span>
							<span class="disp__screen is-client"><b>Client</b><i>streams the desk monitor</i></span>
						</div>
						<p class="body2">
							Streams the monitor on your desk. A hotkey chord switches the active display mid-session,
							without reconnecting.
						</p>
						<p class="meta">Windows & macOS · one active display at a time</p>
					</div>
					<div class="disp__panel" id="disp-virt" role="tabpanel" aria-labelledby="disp-tab-virt" hidden>
						<div class="disp__diagram" aria-hidden="true">
							<span class="disp__screen is-off"><b>Desk monitor</b><i>off</i></span>
							<span class="disp__screen is-on is-virtual"><b>SudoVDA</b><i>matches client</i></span>
							<span class="disp__link"></span>
							<span class="disp__screen is-client"><b>Client</b><i>its own resolution &amp; refresh</i></span>
						</div>
						<p class="body2">
							SudoVDA adds a headless display that matches your client's resolution and refresh rate, so
							the desk monitor can stay off.
						</p>
						<p class="meta">Windows host · third-party driver · <a href="/download#drivers">Get SudoVDA</a></p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section closing">
		<div class="wrap closing__inner" data-reveal>
			<h2 class="display h2">Play from any room. Zero subscription.</h2>
			<p class="lead">Pure-Go desktop host and client for Windows and macOS under Apache-2.0.</p>
			<div class="closing__actions">
				<a class="btn btn--primary btn--lg" href="/download">Download Planck</a>
				<a class="link link--quiet" href="/roadmap"
					>See Windows HDR10, Linux & Cloud status on /roadmap <span class="arrow" aria-hidden="true"
						>→</span
					></a
				>
			</div>
		</div>
	</section>
</Base>

<script>
	import { autoHideHud } from '../scripts/hud';
	import { tablist } from '../scripts/tabs';

	const root = document.querySelector<HTMLElement>('[data-hud-root]');
	const area = root?.querySelector<HTMLElement>('[data-hud-area]');
	const pill = root?.querySelector<HTMLButtonElement>('[data-hud-pill]');
	if (root && area && pill) autoHideHud(root, area, pill, 6000);

	tablist(document.querySelector('[data-display-switch] [role="tablist"]'));
</script>

<style>
	.hero {
		padding: 30px 0 44px;
		background:
			radial-gradient(farthest-corner at 50% 70%, rgba(255, 122, 31, 0.12), transparent 70%),
			var(--carbon-900);
	}
	.hero__row {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 48px;
		margin-top: 14px;
	}
	.hero__title {
		max-width: 720px;
	}
	.hero__sub {
		margin-top: 10px;
		max-width: 760px;
	}
	.hero__buttons {
		display: flex;
		gap: 12px;
		flex: none;
		padding-bottom: 4px;
	}

	.show {
		margin-top: 22px;
		border: 1px solid var(--carbon-700);
		border-radius: var(--radius-md);
		overflow: hidden;
		background: var(--carbon-950);
		box-shadow: 0 24px 64px rgba(0, 0, 0, 0.62);
	}
	.show__screen {
		position: relative;
		aspect-ratio: 2492 / 860;
		overflow: hidden;
	}
	.show__screen :global(picture),
	.show__screen :global(.show__img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.show__vignette {
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, rgba(7, 8, 10, 0.5), transparent 25%, transparent 80%, rgba(7, 8, 10, 0.4));
		pointer-events: none;
	}
	.show__hud {
		position: absolute;
		top: 18px;
		left: 0;
		right: 0;
		display: flex;
		justify-content: center;
	}
	.show__pill {
		cursor: pointer;
	}
	.show__pill[aria-pressed='true'] {
		border-color: rgba(255, 122, 31, 0.6);
	}
	.show__host {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-weight: 500;
	}
	.show__hdr {
		font-weight: 600;
	}
	.show__hint {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 14px;
		text-align: center;
		font-size: 10px;
		color: var(--bone-300);
		text-shadow: 0 1px 6px #000;
	}
	@media (hover: none) {
		.show__hint {
			display: none;
		}
	}
	.show__cap {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		padding: 14px 22px;
		border-top: 1px solid var(--carbon-700);
		background: var(--carbon-850);
		font-size: 11px;
		line-height: 16px;
		color: var(--bone-300);
	}
	.show__cap b {
		font-weight: 500;
		color: var(--bone-50);
	}

	.client {
		display: grid;
		grid-template-columns: 404px 1fr;
		gap: 56px;
		align-items: center;
	}
	.client__lead {
		margin-top: 14px;
		font-size: 15px;
		line-height: 23px;
	}
	.client__features {
		margin-top: 22px;
	}
	.client__features li {
		padding: 16px 0;
		border-top: 1px solid var(--carbon-700);
	}
	.client__features h3 {
		font-size: 14px;
		font-weight: 600;
		margin-bottom: 4px;
	}
	.client__features .body2 {
		font-size: 13px;
		line-height: 19px;
	}

	.app {
		display: grid;
		grid-template-columns: 88px 1fr;
		overflow: hidden;
		min-height: 564px;
	}
	.app__rail {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		padding: 22px 0 20px;
		border-right: 1px solid var(--carbon-700);
		background: var(--carbon-900);
		color: var(--muted);
	}
	.app__rail > :first-child {
		margin-bottom: 8px;
	}
	.app__icon {
		position: relative;
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border-radius: var(--radius-md);
	}
	.app__icon--on {
		color: var(--bone-50);
		background: var(--carbon-800);
	}
	.app__icon--on::before {
		content: '';
		position: absolute;
		left: -18px;
		top: 14px;
		bottom: 14px;
		width: 3px;
		border-radius: 2px;
		background: var(--ember-500);
	}
	.app__spacer {
		flex: 1;
	}
	.app__icon--host {
		color: var(--ember-500);
		background: rgba(255, 122, 31, 0.12);
		box-shadow: inset 0 0 0 1px rgba(255, 122, 31, 0.5);
	}
	.app__main {
		padding: 28px 28px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.app__head {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 12px;
		justify-content: space-between;
		align-items: center;
	}
	.app__title {
		font-size: 21px;
		line-height: 28px;
	}
	.app__status {
		font-size: 10px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.app__search {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 6px 6px 6px 16px;
		border: 1px solid var(--carbon-700);
		border-radius: var(--radius-sm);
		background: var(--carbon-900);
	}
	.app__input {
		font-size: 13px;
