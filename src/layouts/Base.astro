---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	active?: 'gaming' | 'work' | 'roadmap' | 'download';
	/** A file in public/og/, 1200×630. */
	og?: string;
	noindex?: boolean;
}
const { title, description, active, og = 'home.jpg', noindex = false } = Astro.props;
// Pages build to files (work.html); the public address has no extension.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
const canonical = new URL(path, Astro.site);
const image = new URL(`/og/${og}`, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<meta name="theme-color" content="#0E0F12" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="preload" href="/fonts/Archivo.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/MartianMono.woff2" as="font" type="font/woff2" crossorigin />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Planck" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Planck: open-source desktop and game streaming in pure Go" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<Nav active={active} />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<script>
			import '../scripts/reveal';
			import '../scripts/copy';
		</script>
	</body>
</html>
