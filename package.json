{
	"name": "planck-website",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev --port 4321",
		"build": "astro build",
		"preview": "bun run build && wrangler dev",
		"check": "astro check",
		"test": "bun test",
		"lint": "biome check .",
		"format": "biome format --write .",
		"deploy": "bun run build && wrangler deploy",
		"deploy:preview": "SITE_URL=https://planck-website-preview.watzon.workers.dev bun run build && wrangler deploy --env preview",
		"deploy:www": "wrangler deploy --config www/wrangler.jsonc",
		"og": "bun scripts/og.ts"
	},
	"dependencies": {
		"@astrojs/sitemap": "3.7.4",
		"astro": "7.4.7"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@biomejs/biome": "2.6.6",
		"@resvg/resvg-js": "2.6.2",
		"@types/bun": "1.4.4",
		"@types/fontkit": "2.0.9",
		"fontkit": "3.0.0",
		"sharp": "0.35.5",
		"typescript": "6.0.3",
		"wawoff2": "2.0.1",
		"wrangler": "4.158.0"
	}
}
